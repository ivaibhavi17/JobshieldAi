        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Azeret+Mono:wght@400;500;600;700&family=Spline+Sans:wght@400;500;600;700&display=swap');\n.js-app{--frame:#171B1B;--raised:#222727;--surface:#F2F5F2;--paper:#FFFFFF;--ink:#16201F;--copper:#C66A3A;--teal:#4D7973;--low:#3E9569;--moderate:#D2A52E;--high:#DD712E;--very-high:#D54846;font-family:'Spline Sans',sans-serif}\n.js-app .js-mono{font-family:'Azeret Mono',monospace}\n.js-app .js-rule{border-color:var(--ink)}\n.js-app .js-label{font-family:'Azeret Mono',monospace;font-size:10px;line-height:1.3;letter-spacing:.14em;text-transform:uppercase}\n.js-app .risk-marker{animation:js-marker-sweep 900ms linear 1 both;transform-origin:left center}\n@keyframes js-marker-sweep{from{transform:translateX(-14px)}to{transform:translateX(0)}}\n.js-app .trace-current{animation:js-trace-tick 1.8s steps(2,end) infinite}\n@keyframes js-trace-tick{0%,100%{opacity:1}50%{opacity:.58}}\n.js-app textarea{font-family:'Spline Sans',sans-serif}\n.js-app summary{list-style:none}\n.js-app summary::-webkit-details-marker{display:none}\n</style>\n<link data-kid=\"1\" data-name=\"Tabler icons stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<div class=\"js-app min-h-screen overflow-x-clip bg-[var(--frame)] text-[var(--ink)]\" data-kid=\"2\" data-name=\"Application wrapper\">\n    <div class=\"grid min-h-screen grid-cols-[188px_minmax(0,1fr)]\" data-kid=\"2-1\" data-name=\"Main layout grid\">\n        <aside class=\"sticky top-0 flex h-screen flex-col border-r-2 border-[var(--copper)] bg-[var(--frame)] px-5 py-5 text-[var(--surface)]\" data-kid=\"2-1-1\" data-name=\"Sidebar container\">\n            <div class=\"js-mono text-[10px] uppercase tracking-[0.22em] text-[var(--copper)]\" data-kid=\"2-1-1-1\" data-name=\"Brand short name\">\n                JS / 02\n            </div>\n            <div class=\"mt-5 border-l-2 border-[var(--copper)] pl-3\" data-kid=\"2-1-1-2\" data-name=\"Brand identity container\">\n                <div class=\"text-[20px] font-semibold tracking-[-0.04em]\" data-kid=\"2-1-1-2-1\" data-name=\"Brand name text\">\n                    JobShield AI\n                </div>\n                <div class=\"js-mono mt-1 text-[10px] leading-4 text-[var(--surface)]/60\" data-kid=\"2-1-1-2-2\" data-name=\"Brand tagline text\">\n                    Check Before\n                    <br data-kid=\"2-1-1-2-2-1\" data-name=\"Tagline line break\"/>\n                    You Apply.\n                </div>\n            </div>\n            <div class=\"mt-10 border-t border-[var(--surface)]/20 pt-3 js-mono text-[9px] uppercase tracking-[0.12em] text-[var(--surface)]/45\" data-kid=\"2-1-1-3\" data-name=\"Forensic desk label\">\n                Forensic signal desk\n                <br data-kid=\"2-1-1-3-1\" data-name=\"Forensic desk line break\"/>\n                <span class=\"text-[var(--surface)]/65\" data-kid=\"2-1-1-3-2\" data-name=\"Desk status text\">\n                    Risk review workspace\n                </span>\n            </div>\n            <nav aria-label=\"Product sections\" class=\"mt-9 space-y-1 js-mono text-[10px] uppercase tracking-[0.08em]\" data-kid=\"2-1-1-4\" data-name=\"Product navigation bar\">\n                <div class=\"border-l-2 border-[var(--copper)] bg-[var(--raised)] px-3 py-3 font-semibold text-[var(--surface)]\" data-kid=\"2-1-1-4-1\" data-name=\"Analyze navigation item\">\n                    Analyze\n                </div>\n                <div class=\"px-3 py-3 text-[var(--surface)]/55\" data-kid=\"2-1-1-4-2\" data-name=\"Dashboard navigation item\">\n                    Dashboard\n                </div>\n                <div class=\"px-3 py-3 text-[var(--surface)]/55\" data-kid=\"2-1-1-4-3\" data-name=\"History navigation item\">\n                    History\n                </div>\n                <div class=\"px-3 py-3 leading-4 text-[var(--surface)]/55\" data-kid=\"2-1-1-4-4\" data-name=\"Model performance navigation item\">\n                    Model\n                    <br data-kid=\"2-1-1-4-4-1\" data-name=\"Navigation item line break\"/>\n                    performance\n                </div>\n            </nav>\n            <div class=\"mt-auto border-2 border-[var(--surface)]/25 p-3 js-mono text-[10px] uppercase tracking-[0.1em] text-[var(--surface)]/65\" data-kid=\"2-1-1-5\" data-name=\"Demo mode indicator card\">\n                <div class=\"text-[var(--copper)]\" data-kid=\"2-1-1-5-1\" data-name=\"Demo mode title\">\n                    Demo Mode\n                </div>\n                <div class=\"mt-2 leading-4\" data-kid=\"2-1-1-5-2\" data-name=\"Connection status text\">\n                    Model evaluation\n                    <br data-kid=\"2-1-1-5-2-1\" data-name=\"Status line break\"/>\n                    not connected\n                </div>\n            </div>\n            <div class=\"mt-4 js-mono text-[9px] uppercase tracking-[0.12em] text-[var(--surface)]/35\" data-kid=\"2-1-1-6\" data-name=\"Version information\">\n                v0.2 / static overview\n            </div>\n        </aside>\n        <main class=\"min-w-0 bg-[var(--surface)]\" data-kid=\"2-1-2\" data-name=\"Main content area\">\n            <header class=\"flex min-h-[52px] items-center justify-between border-b-2 border-[var(--ink)] px-7 py-4 js-mono text-[10px] uppercase tracking-[0.14em]\" data-kid=\"2-1-2-1\" data-name=\"Page header bar\">\n                <span data-kid=\"2-1-2-1-1\" data-name=\"Header step label\">\n                    01 / Quick check\n                </span>\n                <span class=\"text-[var(--teal)]\" data-kid=\"2-1-2-1-2\" data-name=\"Header status text\">\n                    AI-assisted risk assessment · Demo Data\n                </span>\n            </header>\n            <section aria-labelledby=\"landing-title\" class=\"grid min-h-[620px] grid-cols-[24%_48%_28%] border-b-2 border-[var(--ink)]\" data-kid=\"2-1-2-2\" data-name=\"Landing section\">\n                <div class=\"border-r-2 border-[var(--ink)] p-8\" data-kid=\"2-1-2-2-1\" data-name=\"Landing call-to-action area\">\n                    <div class=\"js-label text-[var(--copper)]\" data-kid=\"2-1-2-2-1-1\" data-name=\"Section pre-headline label\">\n                        Before you apply\n                    </div>\n                    <h1 class=\"mt-8 max-w-[270px] text-[48px] font-semibold leading-[0.99] tracking-[-0.055em]\" data-kid=\"2-1-2-2-1-2\" data-name=\"Hero headline\" id=\"landing-title\">\n                        Is This Job Really Safe?\n                    </h1>\n                    <p class=\"mt-7 max-w-[270px] text-[15px] leading-6\" data-kid=\"2-1-2-2-1-3\" data-name=\"Hero description text\">\n                        Use AI to analyze suspicious job postings and understand potential risk indicators before you apply.\n                    </p>\n                    <p class=\"mt-5 max-w-[270px] border-l-2 border-[var(--teal)] pl-3 text-[12px] leading-5 text-[var(--ink)]/70\" data-kid=\"2-1-2-2-1-4\" data-name=\"Disclaimer text\">\n                        JobShield AI provides an AI-assisted preliminary risk assessment. It may produce false positives or false negatives.\n                    </p>\n                    <div class=\"mt-10 border-t-2 border-[var(--ink)] pt-4\" data-kid=\"2-1-2-2-1-5\" data-name=\"Target audience section\">\n                        <div class=\"js-label\" data-kid=\"2-1-2-2-1-5-1\" data-name=\"Target audience label\">\n                            Designed for\n                        </div>\n                        <div class=\"mt-3 flex flex-wrap gap-2 js-mono text-[9px] uppercase tracking-[0.08em]\" data-kid=\"2-1-2-2-1-5-2\" data-name=\"Target audience tags container\">\n                            <span class=\"border border-[var(--ink)] px-2 py-1\" data-kid=\"2-1-2-2-1-5-2-1\" data-name=\"Student tag\">\n                                Students\n                            </span>\n                            <span class=\"border border-[var(--ink)] px-2 py-1\" data-kid=\"2-1-2-2-1-5-2-2\" data-name=\"Fresher tag\">\n                                Freshers\n                            </span>\n                            <span class=\"border border-[var(--ink)] px-2 py-1\" data-kid=\"2-1-2-2-1-5-2-3\" data-name=\"Job seeker tag\">\n                                Job seekers\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"mt-8 flex items-center gap-2 js-mono text-[9px] uppercase tracking-[0.1em] text-[var(--ink)]/55\" data-kid=\"2-1-2-2-1-6\" data-name=\"Review disclaimer line\">\n                        <span class=\"h-2 w-2 bg-[var(--teal)]\" data-kid=\"2-1-2-2-1-6-1\" data-name=\"Disclaimer status marker\">\n                        </span>\n                        Preliminary review only\n                    </div>\n                </div>\n                <div class=\"border-r-2 border-[var(--ink)] p-8\" data-kid=\"2-1-2-2-2\" data-name=\"Job input section\">\n                    <div class=\"flex items-center justify-between js-label\" data-kid=\"2-1-2-2-2-1\" data-name=\"Input header bar\">\n                        <span data-kid=\"2-1-2-2-2-1-1\" data-name=\"Input title\">\n                            Input / job posting\n                        </span>\n                        <span class=\"text-[var(--teal)]\" data-kid=\"2-1-2-2-2-1-2\" data-name=\"Step indicator\">\n                            Step 01\n                        </span>\n                    </div>\n                    <div aria-label=\"Input methods\" class=\"mt-5 flex border-2 border-[var(--ink)] bg-[var(--paper)] js-mono text-[10px] uppercase tracking-[0.08em]\" data-kid=\"2-1-2-2-2-2\" data-name=\"Input method tab list\" role=\"tablist\">\n                        <div aria-selected=\"true\" class=\"border-r-2 border-[var(--ink)] bg-[var(--ink)] px-3 py-3 font-semibold text-[var(--paper)]\" data-kid=\"2-1-2-2-2-2-1\" data-name=\"Paste text tab\" role=\"tab\">\n                            Paste text\n                        </div>\n                        <div aria-selected=\"false\" class=\"border-r-2 border-[var(--ink)] px-3 py-3 text-[var(--ink)]/65\" data-kid=\"2-1-2-2-2-2-2\" data-name=\"Image upload tab\" role=\"tab\">\n                            Image\n                        </div>\n                        <div aria-selected=\"false\" class=\"px-3 py-3 text-[var(--ink)]/65\" data-kid=\"2-1-2-2-2-2-3\" data-name=\"PDF/TXT upload tab\" role=\"tab\">\n                            PDF or TXT\n                        </div>\n                    </div>\n                    <div class=\"mt-4 border-2 border-[var(--ink)] bg-[var(--paper)]\" data-kid=\"2-1-2-2-2-3\" data-name=\"Input text area\">\n                        <label class=\"block border-b-2 border-[var(--ink)] px-4 py-3 js-label\" data-kid=\"2-1-2-2-2-3-1\" data-name=\"Text area label\" for=\"landing-description\">\n                            Job description\n                        </label>\n                        <textarea aria-label=\"Paste Job Description Here\" class=\"h-[235px] w-full resize-none border-0 bg-[var(--paper)] p-4 text-[14px] leading-6 outline-hidden focus:ring-3 focus:ring-[var(--teal)]\" data-kid=\"2-1-2-2-2-3-2\" data-name=\"Job description input\" id=\"landing-description\">Marketing coordinator — remote. Join a growing team with a clear interview process. Company information and role responsibilities are provided before any decision. No payment is required at any stage.</textarea>\n                        <div class=\"flex items-center justify-between border-t-2 border-[var(--ink)] px-4 py-3 js-mono text-[10px] text-[var(--ink)]/60\" data-kid=\"2-1-2-2-2-3-3\" data-name=\"Text area footer\">\n                            <span data-kid=\"2-1-2-2-2-3-3-1\" data-name=\"Text type indicator\">\n                                Plain text · editable\n                            </span>\n                            <span data-kid=\"2-1-2-2-2-3-3-2\" data-name=\"Character counter\">\n                                0 / 10,000 characters\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"mt-4 grid grid-cols-[1fr_auto] gap-3\" data-kid=\"2-1-2-2-2-4\" data-name=\"Submission control area\">\n                        <button class=\"rounded-[3px] bg-[var(--copper)] px-5 py-3 text-left js-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-[var(--ink)]\" data-kid=\"2-1-2-2-2-4-1\" data-name=\"Analyze button\" type=\"button\">\n                            Analyze a job\n                            <span class=\"ml-2 text-[14px]\" data-kid=\"2-1-2-2-2-4-1-1\" data-name=\"Arrow icon\">\n                                ↗\n                            </span>\n                        </button>\n                        <span class=\"self-center js-mono text-[10px] uppercase tracking-[0.1em] underline decoration-2 underline-offset-4\" data-kid=\"2-1-2-2-2-4-2\" data-name=\"How it works link\">\n                            How it works\n                        </span>\n                    </div>\n                    <div class=\"mt-5 border-t-2 border-[var(--ink)] pt-4 js-mono text-[10px] leading-4 text-[var(--ink)]/65\" data-kid=\"2-1-2-2-2-5\" data-name=\"File upload helper text\">\n                        <i aria-hidden=\"true\" class=\"ti ti-upload mr-2 text-[16px] text-[var(--copper)]\" data-kid=\"2-1-2-2-2-5-1\" data-name=\"Upload icon\">\n                        </i>\n                        Upload screenshot or document · JPG, JPEG, PNG, PDF, TXT · 10 MB limit\n                    </div>\n                    <div class=\"mt-4 grid grid-cols-2 gap-2 js-mono text-[9px] uppercase tracking-[0.08em]\" data-kid=\"2-1-2-2-2-6\" data-name=\"Input method info container\">\n                        <div class=\"border border-[var(--ink)] px-3 py-2\" data-kid=\"2-1-2-2-2-6-1\" data-name=\"OCR method info\">\n                            <span class=\"text-[var(--teal)]\" data-kid=\"2-1-2-2-2-6-1-1\" data-name=\"Method label\">\n                                OCR\n                            </span>\n                            image text extraction\n                        </div>\n                        <div class=\"border border-[var(--ink)] px-3 py-2\" data-kid=\"2-1-2-2-2-6-2\" data-name=\"Document method info\">\n                            <span class=\"text-[var(--teal)]\" data-kid=\"2-1-2-2-2-6-2-1\" data-name=\"Method label\">\n                                TXT/PDF\n                            </span>\n                            document extraction\n                        </div>\n                    </div>\n                </div>\n                <div class=\"p-8\" data-kid=\"2-1-2-2-3\" data-name=\"Workflow section\">\n                    <div class=\"js-label\" data-kid=\"2-1-2-2-3-1\" data-name=\"Workflow section label\">\n                        Workflow\n                    </div>\n                    <div class=\"relative mt-7\" data-kid=\"2-1-2-2-3-2\" data-name=\"Steps container\">\n                        <div class=\"absolute bottom-4 left-[10px] top-4 w-[2px] bg-[var(--copper)]\" data-kid=\"2-1-2-2-3-2-1\" data-name=\"Timeline connector line\">\n                        </div>\n                        <div class=\"space-y-7\" data-kid=\"2-1-2-2-3-2-2\" data-name=\"Steps list\">\n                            <div class=\"relative flex gap-4\" data-kid=\"2-1-2-2-3-2-2-1\" data-name=\"Workflow step 1\">\n                                <span class=\"z-10 flex h-5 w-5 shrink-0 items-center justify-center bg-[var(--copper)] js-mono text-[9px] font-semibold\" data-kid=\"2-1-2-2-3-2-2-1-1\" data-name=\"Step number 1\">\n                                    01\n                                </span>\n                                <div data-kid=\"2-1-2-2-3-2-2-1-2\" data-name=\"Step description\">\n                                    <div class=\"js-mono text-[12px] font-semibold uppercase\" data-kid=\"2-1-2-2-3-2-2-1-2-1\" data-name=\"Step title\">\n                                        Paste\n                                    </div>\n                                    <p class=\"mt-1 text-[12px] leading-4 text-[var(--ink)]/60\" data-kid=\"2-1-2-2-3-2-2-1-2-2\" data-name=\"Step text\">\n                                        Add the job posting.\n                                    </p>\n                                </div>\n                            </div>\n                            <div class=\"relative flex gap-4\" data-kid=\"2-1-2-2-3-2-2-2\" data-name=\"Workflow step 2\">\n                                <span class=\"z-10 flex h-5 w-5 shrink-0 items-center justify-center bg-[var(--copper)] js-mono text-[9px] font-semibold\" data-kid=\"2-1-2-2-3-2-2-2-1\" data-name=\"Step number 2\">\n                                    02\n                                </span>\n                                <div data-kid=\"2-1-2-2-3-2-2-2-2\" data-name=\"Step description\">\n                                    <div class=\"js-mono text-[12px] font-semibold uppercase\" data-kid=\"2-1-2-2-3-2-2-2-2-1\" data-name=\"Step title\">\n                                        Analyze\n                                    </div>\n                                    <p class=\"mt-1 text-[12px] leading-4 text-[var(--ink)]/60\" data-kid=\"2-1-2-2-3-2-2-2-2-2\" data-name=\"Step text\">\n                                        Extract and assess signals.\n                                    </p>\n                                </div>\n                            </div>\n                            <div class=\"relative flex gap-4\" data-kid=\"2-1-2-2-3-2-2-3\" data-name=\"Workflow step 3\">\n                                <span class=\"z-10 flex h-5 w-5 shrink-0 items-center justify-center bg-[var(--copper)] js-mono text-[9px] font-semibold\" data-kid=\"2-1-2-2-3-2-2-3-1\" data-name=\"Step number 3\">\n                                    03\n                                </span>\n                                <div data-kid=\"2-1-2-2-3-2-2-3-2\" data-name=\"Step description\">\n                                    <div class=\"js-mono text-[12px] font-semibold uppercase\" data-kid=\"2-1-2-2-3-2-2-3-2-1\" data-name=\"Step title\">\n                                        Understand\n                                    </div>\n                                    <p class=\"mt-1 text-[12px] leading-4 text-[var(--ink)]/60\" data-kid=\"2-1-2-2-3-2-2-3-2-2\" data-name=\"Step text\">\n                                        Read the reasons plainly.\n                                    </p>\n                                </div>\n                            </div>\n                            <div class=\"relative flex gap-4\" data-kid=\"2-1-2-2-3-2-2-4\" data-name=\"Workflow step 4\">\n                                <span class=\"z-10 flex h-5 w-5 shrink-0 items-center justify-center bg-[var(--copper)] js-mono text-[9px] font-semibold\" data-kid=\"2-1-2-2-3-2-2-4-1\" data-name=\"Step number 4\">\n                                    04\n                                </span>\n                                <div data-kid=\"2-1-2-2-3-2-2-4-2\" data-name=\"Step description\">\n                                    <div class=\"js-mono text-[12px] font-semibold uppercase\" data-kid=\"2-1-2-2-3-2-2-4-2-1\" data-name=\"Step title\">\n                                        Verify\n                                    </div>\n                                    <p class=\"mt-1 text-[12px] leading-4 text-[var(--ink)]/60\" data-kid=\"2-1-2-2-3-2-2-4-2-2\" data-name=\"Step text\">\n                                        Check the employer yourself.\n                                    </p>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"mt-8 inline-block js-mono text-[10px] uppercase tracking-[0.1em] text-[var(--copper)] underline decoration-2 underline-offset-4\" data-kid=\"2-1-2-2-3-3\" data-name=\"Processing details link\">\n                        See processing details ↗\n                    </div>\n                    <div class=\"mt-10 border-t-2 border-[var(--ink)] pt-4\" data-kid=\"2-1-2-2-3-4\" data-name=\"Sample indicator card\">\n                        <div class=\"js-label\" data-kid=\"2-1-2-2-3-4-1\" data-name=\"Sample label\">\n                            Sample indicator\n                        </div>\n                        <p class=\"mt-3 text-[13px] leading-5 underline decoration-[var(--high)] decoration-2 underline-offset-4\" data-kid=\"2-1-2-2-3-4-2\" data-name=\"Sample indicator phrase\">\n                            “payment request before interview”\n                        </p>\n                        <p class=\"mt-2 border-l-2 border-[var(--high)] pl-3 text-[12px] leading-5 text-[var(--ink)]/65\" data-kid=\"2-1-2-2-3-4-3\" data-name=\"Sample indicator explanation\">\n                            A request for money before employment may warrant extra verification.\n                        </p>\n                    </div>\n                </div>\n            </section>\n            <section aria-label=\"Product capabilities\" class=\"grid grid-cols-[1.45fr_0.9fr_0.9fr] border-b-2 border-[var(--ink)]\" data-kid=\"2-1-2-3\" data-name=\"Product capabilities section\">\n                <div class=\"min-h-[238px] border-r-2 border-[var(--ink)] bg-[var(--raised)] p-7 text-[var(--surface)]\" data-kid=\"2-1-2-3-1\" data-name=\"AI Analysis capability\">\n                    <div class=\"flex items-center justify-between js-label\" data-kid=\"2-1-2-3-1-1\" data-name=\"Capability header\">\n                        <span data-kid=\"2-1-2-3-1-1-1\" data-name=\"Capability title\">\n                            AI Analysis\n                        </span>\n                        <span class=\"text-[var(--copper)]\" data-kid=\"2-1-2-3-1-1-2\" data-name=\"Capability step index\">\n                            01 / 03\n                        </span>\n                    </div>\n                    <div class=\"mt-8 grid grid-cols-[1fr_auto_1fr] items-center gap-4\" data-kid=\"2-1-2-3-1-2\" data-name=\"Analysis detail container\">\n                        <div data-kid=\"2-1-2-3-1-2-1\" data-name=\"Input phrase container\">\n                            <div class=\"js-mono text-[9px] uppercase text-[var(--surface)]/50\" data-kid=\"2-1-2-3-1-2-1-1\" data-name=\"Input label\">\n                                Input phrase\n                            </div>\n                            <div class=\"mt-2 text-[15px]\" data-kid=\"2-1-2-3-1-2-1-2\" data-name=\"Input value\">\n                                “Pay registration fee”\n                            </div>\n                        </div>\n                        <div class=\"js-mono text-[16px] text-[var(--copper)]\" data-kid=\"2-1-2-3-1-2-2\" data-name=\"Arrow icon\">\n                            →\n                        </div>\n                        <div data-kid=\"2-1-2-3-1-2-3\" data-name=\"Cleaned tokens container\">\n                            <div class=\"js-mono text-[9px] uppercase text-[var(--surface)]/50\" data-kid=\"2-1-2-3-1-2-3-1\" data-name=\"Token label\">\n                                Cleaned tokens\n                            </div>\n                            <div class=\"mt-2 js-mono text-[12px] text-[var(--copper)]\" data-kid=\"2-1-2-3-1-2-3-2\" data-name=\"Token values\">\n                                pay · registration · fee\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"mt-7 grid grid-cols-2 gap-3 border-t border-[var(--surface)]/25 pt-4\" data-kid=\"2-1-2-3-1-3\" data-name=\"Analysis metadata\">\n                        <div data-kid=\"2-1-2-3-1-3-1\" data-name=\"NLP step section\">\n                            <div class=\"js-mono text-[9px] uppercase text-[var(--surface)]/45\" data-kid=\"2-1-2-3-1-3-1-1\" data-name=\"Metadata label\">\n                                NLP step\n                            </div>\n                            <div class=\"mt-2 text-[12px] text-[var(--surface)]/80\" data-kid=\"2-1-2-3-1-3-1-2\" data-name=\"Metadata value\">\n                                Lowercase · tokenize · clean whitespace\n                            </div>\n                        </div>\n                        <div data-kid=\"2-1-2-3-1-3-2\" data-name=\"Model stage section\">\n                            <div class=\"js-mono text-[9px] uppercase text-[var(--surface)]/45\" data-kid=\"2-1-2-3-1-3-2-1\" data-name=\"Metadata label\">\n                                Model stage\n                            </div>\n                            <div class=\"mt-2 text-[12px] text-[var(--surface)]/80\" data-kid=\"2-1-2-3-1-3-2-2\" data-name=\"Metadata value\">\n                                TF-IDF features ready\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"min-h-[238px] border-r-2 border-[var(--ink)] bg-[var(--paper)] p-7\" data-kid=\"2-1-2-3-2\" data-name=\"Risk Explanation capability\">\n                    <div class=\"flex items-center justify-between js-label\" data-kid=\"2-1-2-3-2-1\" data-name=\"Capability header\">\n                        <span data-kid=\"2-1-2-3-2-1-1\" data-name=\"Capability title\">\n                            Risk Explanation\n                        </span>\n                        <span class=\"text-[var(--high)]\" data-kid=\"2-1-2-3-2-1-2\" data-name=\"Capability step index\">\n                            02 / 03\n                        </span>\n                    </div>\n                    <div class=\"mt-7 border-l-2 border-[var(--high)] pl-4\" data-kid=