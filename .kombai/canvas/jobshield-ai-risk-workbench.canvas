-1-3-5-2\" data-name=\"history row 4 title\">\n                                    Online Marketing Trainee\n                                    <p class=\"mt-1 text-xs font-normal text-[var(--js-ink)]/60\" data-kid=\"1-2-2-6-2-1-3-5-2-1\" data-name=\"history row 4 company\">\n                                        Demo posting\n                                    </p>\n                                </td>\n                                <td class=\"js-mono px-3 py-5 font-bold text-[var(--js-high)]\" data-kid=\"1-2-2-6-2-1-3-5-3\" data-name=\"history row 4 score\">\n                                    72 / 100\n                                </td>\n                                <td class=\"px-3 py-5\" data-kid=\"1-2-2-6-2-1-3-5-4\" data-name=\"history row 4 risk\">\n                                    <span class=\"font-semibold text-[var(--js-high)]\" data-kid=\"1-2-2-6-2-1-3-5-4-1\" data-name=\"history row 4 level\">\n                                        High\n                                    </span>\n                                    <span class=\"mt-1 block text-xs text-[var(--js-ink)]/60\" data-kid=\"1-2-2-6-2-1-3-5-4-2\" data-name=\"history row 4 status\">\n                                        Potentially suspicious\n                                    </span>\n                                </td>\n                                <td class=\"js-mono px-3 py-5 text-[11px]\" data-kid=\"1-2-2-6-2-1-3-5-5\" data-name=\"history row 4 date\">\n                                    18 Jun 2026\n                                </td>\n                                <td class=\"px-3 py-5\" data-kid=\"1-2-2-6-2-1-3-5-6\" data-name=\"history row 4 status\">\n                                    <span class=\"border border-[var(--js-rule)] px-2 py-1 text-xs\" data-kid=\"1-2-2-6-2-1-3-5-6-1\" data-name=\"history row 4 status label\">\n                                        Analyzed\n                                    </span>\n                                    <span class=\"mt-2 block js-mono text-[9px] text-[var(--js-ink)]/55\" data-kid=\"1-2-2-6-2-1-3-5-6-2\" data-name=\"history row 4 demo data\">\n                                        Demo Data\n                                    </span>\n                                </td>\n                                <td class=\"px-5 py-5\" data-kid=\"1-2-2-6-2-1-3-5-7\" data-name=\"history row 4 actions\">\n                                    <div class=\"flex flex-col items-start gap-3\" data-kid=\"1-2-2-6-2-1-3-5-7-1\" data-name=\"history row 4 action container\">\n                                        <span class=\"text-[var(--js-blue)] underline decoration-[var(--js-blue)]/50 underline-offset-4\" data-kid=\"1-2-2-6-2-1-3-5-7-1-1\" data-name=\"row 4 report link\">\n                                            Open full report\n                                        </span>\n                                        <button class=\"js-focus inline-flex items-center gap-2 text-[var(--js-ink)]/80\" data-kid=\"1-2-2-6-2-1-3-5-7-1-2\" data-name=\"row 4 export button\" type=\"button\">\n                                            <span class=\"text-[16px] text-[var(--js-blue)]\" data-kid=\"1-2-2-6-2-1-3-5-7-1-2-1\" data-name=\"row 4 export icon wrapper\">\n                                                <i aria-hidden=\"true\" class=\"ti ti-download\" data-kid=\"1-2-2-6-2-1-3-5-7-1-2-1-1\" data-name=\"row 4 export icon\">\n                                                </i>\n                                            </span>\n                                            Export\n                                        </button>\n                                        <span class=\"h-px w-24 bg-[var(--js-rule)]\" data-kid=\"1-2-2-6-2-1-3-5-7-1-3\" data-name=\"row 4 divider\">\n                                        </span>\n                                        <button class=\"js-focus inline-flex items-center gap-2 text-[var(--js-very-high)]\" data-kid=\"1-2-2-6-2-1-3-5-7-1-4\" data-name=\"row 4 delete button\" type=\"button\">\n                                            <span class=\"text-[16px] text-[var(--js-very-high)]\" data-kid=\"1-2-2-6-2-1-3-5-7-1-4-1\" data-name=\"row 4 delete icon wrapper\">\n                                                <i aria-hidden=\"true\" class=\"ti ti-trash\" data-kid=\"1-2-2-6-2-1-3-5-7-1-4-1-1\" data-name=\"row 4 delete icon\">\n                                                </i>\n                                            </span>\n                                            Delete analysis\n                                        </button>\n                                    </div>\n                                </td>\n                            </tr>\n                        </tbody>\n                    </table>\n                </div>\n                <div class=\"mt-5 flex items-start gap-3 text-xs leading-5 text-[var(--js-ink)]/68\" data-kid=\"1-2-2-6-3\" data-name=\"history footer note\">\n                    <span class=\"js-mono text-[10px] text-[var(--js-blue)]\" data-kid=\"1-2-2-6-3-1\" data-name=\"history note label\">\n                        NOTE\n                    </span>\n                    <span data-kid=\"1-2-2-6-3-2\" data-name=\"history note text\">\n                        Delete and export controls are shown as interface states only in this stateless presentation node.\n                    </span>\n                </div>\n            </section>\n            <section class=\"scroll-mt-24 border-b-2 border-[var(--js-ink)] py-10\" data-kid=\"1-2-2-7\" data-name=\"model performance section\" id=\"model-performance\">\n                <div class=\"flex flex-wrap items-end justify-between gap-6 border-b-2 border-[var(--js-ink)] pb-5\" data-kid=\"1-2-2-7-1\" data-name=\"model performance header\">\n                    <div data-kid=\"1-2-2-7-1-1\" data-name=\"model performance heading container\">\n                        <p class=\"js-mono text-[10px] uppercase tracking-[0.2em] text-[var(--js-blue)]\" data-kid=\"1-2-2-7-1-1-1\" data-name=\"model performance label\">\n                            06 / technical appendix\n                        </p>\n                        <h2 class=\"js-display mt-3 text-5xl font-bold tracking-[-0.05em]\" data-kid=\"1-2-2-7-1-1-2\" data-name=\"model performance heading\">\n                            Model performance\n                        </h2>\n                    </div>\n                    <p class=\"max-w-[390px] text-right text-sm leading-5 text-[var(--js-ink)]/70\" data-kid=\"1-2-2-7-1-2\" data-name=\"model performance description\">\n                        Actual evaluation results belong here when a labeled dataset, train/test split, and saved model are connected.\n                    </p>\n                </div>\n                <div class=\"mt-7 bg-[var(--js-source)] ring-1 ring-[var(--js-rule)]\" data-kid=\"1-2-2-7-2\" data-name=\"evaluation table container\">\n                    <div class=\"flex flex-wrap items-center justify-between gap-3 border-b border-[var(--js-rule)] px-6 py-4\" data-kid=\"1-2-2-7-2-1\" data-name=\"evaluation table header\">\n                        <h3 class=\"js-display text-xl font-bold\" data-kid=\"1-2-2-7-2-1-1\" data-name=\"evaluation table heading\">\n                            Evaluation comparison\n                        </h3>\n                        <span class=\"js-mono text-[9px] uppercase tracking-[0.14em] text-[var(--js-rust)]\" data-kid=\"1-2-2-7-2-1-2\" data-name=\"evaluation mode label\">\n                            Demo Mode · actual metrics unavailable\n                        </span>\n                    </div>\n                    <div class=\"overflow-x-auto\" data-kid=\"1-2-2-7-2-2\" data-name=\"evaluation table scroll wrapper\">\n                        <table class=\"w-full min-w-[860px] text-left text-sm\" data-kid=\"1-2-2-7-2-2-1\" data-name=\"evaluation table\">\n                            <thead class=\"border-b border-[var(--js-rule)]\" data-kid=\"1-2-2-7-2-2-1-1\" data-name=\"evaluation table header\">\n                                <tr class=\"js-mono text-[9px] uppercase tracking-[0.12em] text-[var(--js-ink)]/60\" data-kid=\"1-2-2-7-2-2-1-1-1\" data-name=\"evaluation header row\">\n                                    <th class=\"px-6 py-4\" data-kid=\"1-2-2-7-2-2-1-1-1-1\" data-name=\"evaluation model header\">\n                                        Model\n                                    </th>\n                                    <th class=\"px-4 py-4\" data-kid=\"1-2-2-7-2-2-1-1-1-2\" data-name=\"evaluation accuracy header\">\n                                        Accuracy\n                                    </th>\n                                    <th class=\"px-4 py-4\" data-kid=\"1-2-2-7-2-2-1-1-1-3\" data-name=\"evaluation precision header\">\n                                        Precision\n                                    </th>\n                                    <th class=\"px-4 py-4\" data-kid=\"1-2-2-7-2-2-1-1-1-4\" data-name=\"evaluation recall header\">\n                                        Recall\n                                    </th>\n                                    <th class=\"px-4 py-4\" data-kid=\"1-2-2-7-2-2-1-1-1-5\" data-name=\"evaluation f1 header\">\n                                        F1-score\n                                    </th>\n                                    <th class=\"px-6 py-4\" data-kid=\"1-2-2-7-2-2-1-1-1-6\" data-name=\"evaluation status header\">\n                                        Status\n                                    </th>\n                                </tr>\n                            </thead>\n                            <tbody data-kid=\"1-2-2-7-2-2-1-2\" data-name=\"evaluation table body\">\n                                <tr class=\"border-b border-[var(--js-rule)]\" data-kid=\"1-2-2-7-2-2-1-2-1\" data-name=\"model 1 row\">\n                                    <td class=\"px-6 py-5 font-semibold\" data-kid=\"1-2-2-7-2-2-1-2-1-1\" data-name=\"model 1 name\">\n                                        Logistic Regression\n                                    </td>\n                                    <td class=\"js-mono px-4 text-[11px]\" data-kid=\"1-2-2-7-2-2-1-2-1-2\" data-name=\"model 1 accuracy\">\n                                        Unavailable\n                                    </td>\n                                    <td class=\"js-mono px-4 text-[11px]\" data-kid=\"1-2-2-7-2-2-1-2-1-3\" data-name=\"model 1 precision\">\n                                        Unavailable\n                                    </td>\n                                    <td class=\"js-mono px-4 text-[11px]\" data-kid=\"1-2-2-7-2-2-1-2-1-4\" data-name=\"model 1 recall\">\n                                        Unavailable\n                                    </td>\n                                    <td class=\"js-mono px-4 text-[11px]\" data-kid=\"1-2-2-7-2-2-1-2-1-5\" data-name=\"model 1 f1\">\n                                        Unavailable\n                                    </td>\n                                    <td class=\"px-6 text-[var(--js-ink)]/65\" data-kid=\"1-2-2-7-2-2-1-2-1-6\" data-name=\"model 1 status\">\n                                        Awaiting evaluation\n                                    </td>\n                                </tr>\n                                <tr class=\"border-b border-[var(--js-rule)]\" data-kid=\"1-2-2-7-2-2-1-2-2\" data-name=\"model 2 row\">\n                                    <td class=\"px-6 py-5 font-semibold\" data-kid=\"1-2-2-7-2-2-1-2-2-1\" data-name=\"model 2 name\">\n                                        Naive Bayes\n                                    </td>\n                                    <td class=\"js-mono px-4 text-[11px]\" data-kid=\"1-2-2-7-2-2-1-2-2-2\" data-name=\"model 2 accuracy\">\n                                        Unavailable\n                                    </td>\n                                    <td class=\"js-mono px-4 text-[11px]\" data-kid=\"1-2-2-7-2-2-1-2-2-3\" data-name=\"model 2 precision\">\n                                        Unavailable\n                                    </td>\n                                    <td class=\"js-mono px-4 text-[11px]\" data-kid=\"1-2-2-7-2-2-1-2-2-4\" data-name=\"model 2 recall\">\n                                        Unavailable\n                                    </td>\n                                    <td class=\"js-mono px-4 text-[11px]\" data-kid=\"1-2-2-7-2-2-1-2-2-5\" data-name=\"model 2 f1\">\n                                        Unavailable\n                                    </td>\n                                    <td class=\"px-6 text-[var(--js-ink)]/65\" data-kid=\"1-2-2-7-2-2-1-2-2-6\" data-name=\"model 2 status\">\n                                        Awaiting evaluation\n                                    </td>\n                                </tr>\n                                <tr data-kid=\"1-2-2-7-2-2-1-2-3\" data-name=\"model 3 row\">\n                                    <td class=\"px-6 py-5\" data-kid=\"1-2-2-7-2-2-1-2-3-1\" data-name=\"model 3 name wrapper\">\n                                        <span class=\"js-bracket inline-block px-5 py-2 font-semibold\" data-kid=\"1-2-2-7-2-2-1-2-3-1-1\" data-name=\"model 3 name\">\n                                            Random Forest\n                                        </span>\n                                    </td>\n                                    <td class=\"js-mono px-4 text-[11px]\" data-kid=\"1-2-2-7-2-2-1-2-3-2\" data-name=\"model 3 accuracy\">\n                                        Unavailable\n                                    </td>\n                                    <td class=\"js-mono px-4 text-[11px]\" data-kid=\"1-2-2-7-2-2-1-2-3-3\" data-name=\"model 3 precision\">\n                                        Unavailable\n                                    </td>\n                                    <td class=\"js-mono px-4 text-[11px]\" data-kid=\"1-2-2-7-2-2-1-2-3-4\" data-name=\"model 3 recall\">\n                                        Unavailable\n                                    </td>\n                                    <td class=\"js-mono px-4 text-[11px]\" data-kid=\"1-2-2-7-2-2-1-2-3-5\" data-name=\"model 3 f1\">\n                                        Unavailable\n                                    </td>\n                                    <td class=\"px-6 font-semibold text-[var(--js-blue)]\" data-kid=\"1-2-2-7-2-2-1-2-3-6\" data-name=\"model 3 status\">\n                                        Selected model · pending validation\n                                    </td>\n                                </tr>\n                            </tbody>\n                        </table>\n                    </div>\n                </div>\n                <div class=\"mt-8 grid grid-cols-1 gap-8 lg:grid-cols-[0.82fr_1.18fr]\" data-kid=\"1-2-2-7-3\" data-name=\"evaluation grid\">\n                    <article data-kid=\"1-2-2-7-3-1\" data-name=\"confusion matrix panel\">\n                        <p class=\"js-mono text-[9px] uppercase tracking-[0.15em] text-[var(--js-blue)]\" data-kid=\"1-2-2-7-3-1-1\" data-name=\"confusion label\">\n                            actual output\n                        </p>\n                        <h3 class=\"js-display mt-2 text-2xl font-bold\" data-kid=\"1-2-2-7-3-1-2\" data-name=\"confusion heading\">\n                            Confusion matrix\n                        </h3>\n                        <p class=\"mt-2 max-w-[360px] text-sm leading-5 text-[var(--js-ink)]/70\" data-kid=\"1-2-2-7-3-1-3\" data-name=\"confusion description\">\n                            The matrix stays unavailable until a trained model produces evaluation output.\n                        </p>\n                        <div class=\"mt-6 grid grid-cols-[72px_1fr_1fr] border border-[var(--js-rule)] text-center text-[11px]\" data-kid=\"1-2-2-7-3-1-4\" data-name=\"confusion matrix\">\n                            <div data-kid=\"1-2-2-7-3-1-4-1\" data-name=\"matrix filler\">\n                            </div>\n                            <div class=\"border-b border-l border-[var(--js-rule)] p-3 js-mono text-[9px]\" data-kid=\"1-2-2-7-3-1-4-2\" data-name=\"matrix col 1 header\">\n                                pred. lower\n                            </div>\n                            <div class=\"border-b border-l border-[var(--js-rule)] p-3 js-mono text-[9px]\" data-kid=\"1-2-2-7-3-1-4-3\" data-name=\"matrix col 2 header\">\n                                pred. susp.\n                            </div>\n                            <div class=\"flex items-center justify-center border-t border-[var(--js-rule)] p-2 [writing-mode:vertical-rl] js-mono text-[9px]\" data-kid=\"1-2-2-7-3-1-4-4\" data-name=\"matrix row 1 header\">\n                                actual lower\n                            </div>\n                            <div class=\"border-l border-t border-[var(--js-rule)] p-8 js-mono\" data-kid=\"1-2-2-7-3-1-4-5\" data-name=\"matrix cell 1-1\">\n                                —\n                            </div>\n                            <div class=\"border-l border-t border-[var(--js-rule)] p-8 js-mono\" data-kid=\"1-2-2-7-3-1-4-6\" data-name=\"matrix cell 1-2\">\n                                —\n                            </div>\n                            <div class=\"flex items-center justify-center border-t border-[var(--js-rule)] p-2 [writing-mode:vertical-rl] js-mono text-[9px]\" data-kid=\"1-2-2-7-3-1-4-7\" data-name=\"matrix row 2 header\">\n                                actual susp.\n                            </div>\n                            <div class=\"border-l border-t border-[var(--js-rule)] p-8 js-mono\" data-kid=\"1-2-2-7-3-1-4-8\" data-name=\"matrix cell 2-1\">\n                                —\n                            </div>\n                            <div class=\"border-l border-t border-[var(--js-rule)] p-8 js-mono\" data-kid=\"1-2-2-7-3-1-4-9\" data-name=\"matrix cell 2-2\">\n                                —\n                            </div>\n                        </div>\n                    </article>\n                    <aside class=\"border-t border-[var(--js-rule)] pt-5 lg:border-l lg:border-t-0 lg:pl-8\" data-kid=\"1-2-2-7-3-2\" data-name=\"performance sidebar\">\n                        <p class=\"js-mono text-[9px] uppercase tracking-[0.15em] text-[var(--js-blue)]\" data-kid=\"1-2-2-7-3-2-1\" data-name=\"performance sidebar label\">\n                            reading the appendix\n                        </p>\n                        <h3 class=\"js-display mt-2 text-2xl font-bold\" data-kid=\"1-2-2-7-3-2-2\" data-name=\"performance sidebar heading\">\n                            Confidence is unavailable\n                        </h3>\n                        <p class=\"mt-4 max-w-[650px] text-[16px] leading-6\" data-kid=\"1-2-2-7-3-2-3\" data-name=\"performance sidebar text\">\n                            No actual metrics are shown in Demo Mode. Recall helps us see how often suspicious examples are found; false negatives are postings the model does not flag and still need human verification. The evaluation service should report all measures before a model is presented as selected.\n                        </p>\n                        <div class=\"mt-6 border-t border-[var(--js-rule)] pt-4 text-sm leading-5 text-[var(--js-ink)]/70\" data-kid=\"1-2-2-7-3-2-4\" data-name=\"performance sidebar footer\">\n                            Required inputs: labeled CSV dataset · completed train/test split · saved TF-IDF vectorizer · evaluated model output.\n                        </div>\n                    </aside>\n                </div>\n                <div class=\"mt-7 border-l-2 border-[var(--js-rust)] bg-[var(--js-source)] px-5 py-4 text-sm leading-5 ring-1 ring-[var(--js-rule)]\" data-kid=\"1-2-2-7-4\" data-name=\"performance disclaimer\">\n                    <strong data-kid=\"1-2-2-7-4-1\" data-name=\"performance disclaimer label\">\n                        Why this matters.\n                    </strong>\n                    Accuracy, precision, recall, F1-score, and the confusion matrix should be actual results from the connected training pipeline—not invented values.\n                </div>\n            </section>\n            <footer class=\"flex flex-col gap-3 py-8 text-xs text-[var(--js-ink)]/65 sm:flex-row sm:items-center sm:justify-between\" data-kid=\"1-2-2-8\" data-name=\"footer\">\n                <span class=\"js-display text-sm font-bold text-[var(--js-ink)]\" data-kid=\"1-2-2-8-1\" data-name=\"footer title\">\n                    JobShield AI\n                </span>\n                <span data-kid=\"1-2-2-8-2\" data-name=\"footer text\">\n                    Check Before You Apply. · AI-assisted risk assessment · Always independently verify the employer.\n                </span>\n                <span class=\"js-mono text-[9px] uppercase tracking-[0.12em]\" data-kid=\"1-2-2-8-3\" data-name=\"footer meta\">\n                    Demo Data / 2026\n                </span>\n            </footer>\n        </main>\n    </div>\n</div>\n<script>\n    document.addEventListener('DOMContentLoaded', function () {\n    document.querySelectorAll('[data-source-group]').forEach(function (group) {\n      var shell = group.closest('[data-source-shell]');\n      if (!shell) return;\n      var controls = group.querySelectorAll('[data-source]');\n      var panels = shell.querySelectorAll('[data-source-panel]');\n      controls.forEach(function (control) {\n        control.addEventListener('click', function () {\n          var source = control.getAttribute('data-source');\n          controls.forEach(function (item) {\n            item.setAttribute('aria-pressed', item.getAttribute('data-source') === source ? 'true' : 'false');\n          });\n          panels.forEach(function (panel) {\n            panel.classList.toggle('hidden', panel.getAttribute('data-source-panel') !== source);\n          });\n        });\n      });\n    });\n\n    function focusEvidence(key) {\n      document.querySelectorAll('[data-evidence]').forEach(function (item) {\n        item.classList.toggle('is-active', item.getAttribute('data-evidence') === key);\n      });\n      document.querySelectorAll('[data-note]').forEach(function (item) {\n        item.classList.toggle('is-active', item.getAttribute('data-note') === key);\n      });\n    }\n    document.querySelectorAll('[data-evidence]').forEach(function (item) {\n      item.addEventListener('mouseenter', function () { focusEvidence(item.getAttribute('data-evidence')); });\n      item.addEventListener('focus', function () { focusEvidence(item.getAttribute('data-evidence')); });\n      item.addEventListener('click', function () { focusEvidence(item.getAttribute('data-evidence')); });\n    });\n  });\n</script>\n",
