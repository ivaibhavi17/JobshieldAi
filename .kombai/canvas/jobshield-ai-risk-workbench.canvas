      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible+Next:wght@400;500;600;700&family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700&family=Fragment+Mono&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n:root {\n  --js-mineral: #E8EFF0;\n  --js-source: #FBFDFC;\n  --js-ink: #17384A;\n  --js-blue: #2B4AA0;\n  --js-rust: #C64A37;\n  --js-rule: #91A8AE;\n  --js-low: #237A59;\n  --js-moderate: #A97800;\n  --js-high: #C4601A;\n  --js-very-high: #B62D38;\n}\n.js-display { font-family: 'Bricolage Grotesque', sans-serif; }\n.js-body { font-family: 'Atkinson Hyperlegible Next', sans-serif; }\n.js-mono { font-family: 'Fragment Mono', monospace; }\n.js-bracket { position: relative; }\n.js-bracket::before,\n.js-bracket::after { content: ''; position: absolute; top: 7px; bottom: 7px; width: 10px; border-top: 2px solid var(--js-blue); border-bottom: 2px solid var(--js-blue); pointer-events: none; }\n.js-bracket::before { left: -2px; border-left: 2px solid var(--js-blue); }\n.js-bracket::after { right: -2px; border-right: 2px solid var(--js-blue); }\n.js-bracket-rust::before,\n.js-bracket-rust::after { border-color: var(--js-rust); }\n.js-bracket-rust::before { border-left-color: var(--js-rust); }\n.js-bracket-rust::after { border-right-color: var(--js-rust); }\n.js-evidence-note { position: relative; }\n.js-evidence-note::before { content: ''; position: absolute; left: -31px; top: 31px; width: 24px; border-top: 1px solid var(--js-rule); }\n.js-evidence-note.is-active::after { content: ''; position: absolute; inset: 7px -1px 7px -7px; border-top: 2px solid var(--js-blue); border-bottom: 2px solid var(--js-blue); border-left: 2px solid var(--js-blue); pointer-events: none; }\n.js-evidence-highlight { border-bottom: 2px solid var(--js-very-high); color: var(--js-very-high); }\n.js-evidence-highlight.is-active { background: var(--js-blue); border-bottom-color: var(--js-blue); color: var(--js-source); }\n.js-source-control[aria-pressed=\"true\"] { background: var(--js-ink); color: var(--js-source); }\n.js-source-control[aria-pressed=\"false\"] { background: transparent; color: var(--js-ink); }\n.js-source-control:focus-visible,\n.js-evidence-highlight:focus-visible,\n.js-focus:focus-visible { outline: 3px solid var(--js-blue); outline-offset: 3px; }\n.js-upload-target { border: 1px dashed var(--js-rule); }\n.js-source-control[aria-pressed=\"true\"] { position: relative; }\n.js-source-control[aria-pressed=\"true\"]::before,\n.js-source-control[aria-pressed=\"true\"]::after { content: ''; position: absolute; top: 7px; bottom: 7px; width: 5px; border-top: 1px solid var(--js-rust); border-bottom: 1px solid var(--js-rust); pointer-events: none; }\n.js-source-control[aria-pressed=\"true\"]::before { left: 5px; border-left: 1px solid var(--js-rust); }\n.js-source-control[aria-pressed=\"true\"]::after { right: 5px; border-right: 1px solid var(--js-rust); }\n#analyze > div:first-child { border-bottom-width: 1px; }\n#dashboard > div:first-child { align-items: flex-start; }\n#history > div:first-child { display: block; }\n#history > div:first-child > p { margin-top: .8rem; max-width: 560px; text-align: left; }\n#model-performance > div:first-child { display: block; border-bottom: 0; border-left: 2px solid var(--js-blue); padding-left: 1rem; }\n#model-performance > div:first-child > p { margin-top: .8rem; max-width: 600px; text-align: left; }\n#history td:last-child > div { flex-direction: row; flex-wrap: wrap; align-items: center; column-gap: 1rem; row-gap: .6rem; }\n#history td:last-child > div > span.h-px { display: none; }\n#history td:last-child > div > button:last-child { border-left: 1px solid var(--js-rule); padding-left: 1rem; }\n@media (min-width: 768px) {\n  .js-feature-inspect { display: grid; grid-template-columns: 24px minmax(0, 1fr); column-gap: 1rem; align-content: start; }\n  .js-feature-inspect > span { grid-column: 1; grid-row: 1 / span 2; }\n  .js-feature-inspect > p:first-of-type { grid-column: 2; grid-row: 1; }\n  .js-feature-inspect > h3 { grid-column: 2; grid-row: 2; }\n  .js-feature-inspect > p:nth-of-type(2) { grid-column: 1 / -1; grid-row: 3; }\n  .js-feature-inspect > p:last-child { grid-column: 1 / -1; grid-row: 4; }\n  .js-feature-explain { display: flex; flex-direction: column; border-top: 4px solid var(--js-blue); }\n  .js-feature-explain > p:last-child { margin-top: auto; border-left: 0; border-top: 2px solid var(--js-rule); padding: 1rem 0 0; }\n  .js-feature-guidance { display: grid; grid-template-columns: minmax(0, 1fr) auto; column-gap: 1rem; align-content: start; }\n  .js-feature-guidance > span { grid-column: 2; grid-row: 1; justify-self: end; }\n  .js-feature-guidance > p:first-of-type { grid-column: 1 / -1; grid-row: 2; }\n  .js-feature-guidance > h3 { grid-column: 1 / -1; grid-row: 3; }\n  .js-feature-guidance > p:nth-of-type(2) { grid-column: 1 / -1; grid-row: 4; }\n  .js-feature-guidance > p:last-child { grid-column: 1 / -1; grid-row: 5; border-left: 0; border-right: 2px solid var(--js-rule); padding-left: 0; padding-right: .75rem; text-align: right; }\n}\n.js-chart-grid { background-color: rgba(251,253,252,.24); }\n.js-histogram-zone { position: relative; background-color: rgba(251,253,252,.24); }\n@media (max-width: 1023px) {\n  .js-evidence-note::before { display: none; }\n  .js-evidence-note.is-active::after { inset: 7px -1px 7px -1px; border-right: 2px solid var(--js-blue); }\n}\n</style>\n<div class=\"js-body js-scroll min-h-screen w-full overflow-x-clip bg-[var(--js-mineral)] text-[var(--js-ink)]\" data-kid=\"1\" data-name=\"main page layout container\">\n    <header class=\"sticky top-0 z-30 border-b border-[var(--js-rule)] bg-[var(--js-mineral)]\" data-kid=\"1-1\" data-name=\"header section\">\n        <div class=\"mx-auto flex h-[74px] max-w-[1440px] items-center justify-between gap-6 px-8 lg:px-12\" data-kid=\"1-1-1\" data-name=\"header layout container\">\n            <div class=\"flex shrink-0 items-center gap-4\" data-kid=\"1-1-1-1\" data-name=\"brand and slogan container\">\n                <a class=\"js-display text-[21px] font-bold tracking-[-0.04em]\" data-kid=\"1-1-1-1-1\" data-name=\"site title link\" href=\"#landing\">\n                    JobShield AI\n                </a>\n                <span class=\"h-5 w-px bg-[var(--js-rule)]\" data-kid=\"1-1-1-1-2\" data-name=\"vertical separator line\">\n                </span>\n                <span class=\"js-mono text-[10px] uppercase tracking-[0.16em] text-[var(--js-ink)]/65\" data-kid=\"1-1-1-1-3\" data-name=\"tagline text\">\n                    Check Before You Apply.\n                </span>\n            </div>\n            <nav aria-label=\"Primary\" class=\"flex items-center gap-5 text-[13px] font-semibold lg:gap-7\" data-kid=\"1-1-1-2\" data-name=\"primary navigation menu\">\n                <a class=\"border-b-2 border-[var(--js-rust)] pb-1\" data-kid=\"1-1-1-2-1\" data-name=\"analyze section link\" href=\"#analyze\">\n                    Analyze\n                </a>\n                <a class=\"text-[var(--js-ink)]/75\" data-kid=\"1-1-1-2-2\" data-name=\"dashboard section link\" href=\"#dashboard\">\n                    Dashboard\n                </a>\n                <a class=\"text-[var(--js-ink)]/75\" data-kid=\"1-1-1-2-3\" data-name=\"history section link\" href=\"#history\">\n                    History\n                </a>\n                <a class=\"text-[var(--js-ink)]/75\" data-kid=\"1-1-1-2-4\" data-name=\"model performance section link\" href=\"#model-performance\">\n                    Model performance\n                </a>\n                <span class=\"hidden h-5 w-px bg-[var(--js-rule)] lg:block\" data-kid=\"1-1-1-2-5\" data-name=\"navigation separator\">\n                </span>\n                <span class=\"js-mono hidden text-[10px] uppercase tracking-[0.12em] text-[var(--js-ink)]/55 lg:inline\" data-kid=\"1-1-1-2-6\" data-name=\"index page label\">\n                    Index 01—06\n                </span>\n            </nav>\n        </div>\n    </header>\n    <div class=\"mx-auto grid max-w-[1440px] grid-cols-1 gap-7 px-8 py-8 lg:grid-cols-[168px_minmax(0,1fr)] lg:px-10 xl:px-12\" data-kid=\"1-2\" data-name=\"main content grid\">\n        <aside class=\"hidden self-start lg:sticky lg:top-[100px] lg:block\" data-kid=\"1-2-1\" data-name=\"side navigation container\">\n            <div class=\"border-l-2 border-[var(--js-blue)] pl-4\" data-kid=\"1-2-1-1\" data-name=\"side navigation wrapper\">\n                <p class=\"js-mono text-[10px] uppercase tracking-[0.16em] text-[var(--js-blue)]\" data-kid=\"1-2-1-1-1\" data-name=\"side nav header text\">\n                    Page index\n                </p>\n                <p class=\"mt-2 text-xs leading-4 text-[var(--js-ink)]/65\" data-kid=\"1-2-1-1-2\" data-name=\"side nav description text\">\n                    A field guide to each product surface.\n                </p>\n                <ol class=\"mt-7 space-y-4 border-t border-[var(--js-rule)] pt-5\" data-kid=\"1-2-1-1-3\" data-name=\"side nav links list\">\n                    <li data-kid=\"1-2-1-1-3-1\" data-name=\"start link\">\n                        <a class=\"group flex gap-3 text-xs\" data-kid=\"1-2-1-1-3-1-1\" data-name=\"start link wrapper\" href=\"#landing\">\n                            <span class=\"js-mono text-[var(--js-blue)]\" data-kid=\"1-2-1-1-3-1-1-1\" data-name=\"start link index number\">\n                                01\n                            </span>\n                            <span class=\"group-hover:text-[var(--js-blue)]\" data-kid=\"1-2-1-1-3-1-1-2\" data-name=\"start link title\">\n                                Start\n                            </span>\n                        </a>\n                    </li>\n                    <li data-kid=\"1-2-1-1-3-2\" data-name=\"analyze job link\">\n                        <a class=\"group flex gap-3 text-xs\" data-kid=\"1-2-1-1-3-2-1\" data-name=\"analyze job link wrapper\" href=\"#analyze\">\n                            <span class=\"js-mono text-[var(--js-blue)]\" data-kid=\"1-2-1-1-3-2-1-1\" data-name=\"analyze job index number\">\n                                02\n                            </span>\n                            <span class=\"group-hover:text-[var(--js-blue)]\" data-kid=\"1-2-1-1-3-2-1-2\" data-name=\"analyze job title\">\n                                Analyze a job\n                            </span>\n                        </a>\n                    </li>\n                    <li data-kid=\"1-2-1-1-3-3\" data-name=\"risk summary link\">\n                        <a class=\"group flex gap-3 text-xs\" data-kid=\"1-2-1-1-3-3-1\" data-name=\"risk summary link wrapper\" href=\"#report\">\n                            <span class=\"js-mono text-[var(--js-blue)]\" data-kid=\"1-2-1-1-3-3-1-1\" data-name=\"risk summary index number\">\n                                03\n                            </span>\n                            <span class=\"group-hover:text-[var(--js-blue)]\" data-kid=\"1-2-1-1-3-3-1-2\" data-name=\"risk summary title\">\n                                Risk summary\n                            </span>\n                        </a>\n                    </li>\n                    <li data-kid=\"1-2-1-1-3-4\" data-name=\"dashboard link\">\n                        <a class=\"group flex gap-3 text-xs\" data-kid=\"1-2-1-1-3-4-1\" data-name=\"dashboard link wrapper\" href=\"#dashboard\">\n                            <span class=\"js-mono text-[var(--js-blue)]\" data-kid=\"1-2-1-1-3-4-1-1\" data-name=\"dashboard index number\">\n                                04\n                            </span>\n                            <span class=\"group-hover:text-[var(--js-blue)]\" data-kid=\"1-2-1-1-3-4-1-2\" data-name=\"dashboard title\">\n                                Dashboard\n                            </span>\n                        </a>\n                    </li>\n                    <li data-kid=\"1-2-1-1-3-5\" data-name=\"past analyses link\">\n                        <a class=\"group flex gap-3 text-xs\" data-kid=\"1-2-1-1-3-5-1\" data-name=\"past analyses link wrapper\" href=\"#history\">\n                            <span class=\"js-mono text-[var(--js-blue)]\" data-kid=\"1-2-1-1-3-5-1-1\" data-name=\"past analyses index number\">\n                                05\n                            </span>\n                            <span class=\"group-hover:text-[var(--js-blue)]\" data-kid=\"1-2-1-1-3-5-1-2\" data-name=\"past analyses title\">\n                                Past analyses\n                            </span>\n                        </a>\n                    </li>\n                    <li data-kid=\"1-2-1-1-3-6\" data-name=\"model performance link\">\n                        <a class=\"group flex gap-3 text-xs\" data-kid=\"1-2-1-1-3-6-1\" data-name=\"model performance link wrapper\" href=\"#model-performance\">\n                            <span class=\"js-mono text-[var(--js-blue)]\" data-kid=\"1-2-1-1-3-6-1-1\" data-name=\"model performance index number\">\n                                06\n                            </span>\n                            <span class=\"group-hover:text-[var(--js-blue)]\" data-kid=\"1-2-1-1-3-6-1-2\" data-name=\"model performance title\">\n                                Model performance\n                            </span>\n                        </a>\n                    </li>\n                </ol>\n                <div class=\"mt-9 border-t border-[var(--js-rule)] pt-4\" data-kid=\"1-2-1-1-4\" data-name=\"demo state notice\">\n                    <span class=\"js-mono text-[9px] uppercase tracking-[0.13em] text-[var(--js-ink)]/55\" data-kid=\"1-2-1-1-4-1\" data-name=\"demo state label\">\n                        state\n                    </span>\n                    <p class=\"mt-2 text-xs font-semibold\" data-kid=\"1-2-1-1-4-2\" data-name=\"demo state title\">\n                        Demo Data\n                    </p>\n                    <p class=\"mt-1 text-xs leading-4 text-[var(--js-ink)]/65\" data-kid=\"1-2-1-1-4-3\" data-name=\"demo state text\">\n                        Actual model confidence is unavailable.\n                    </p>\n                </div>\n            </div>\n        </aside>\n        <main class=\"min-w-0\" data-kid=\"1-2-2\" data-name=\"main content area\">\n            <section class=\"scroll-mt-24 border-b-2 border-[var(--js-ink)] pb-10\" data-kid=\"1-2-2-1\" data-name=\"landing section\" id=\"landing\">\n                <div class=\"flex items-end justify-between gap-6 border-b border-[var(--js-rule)] pb-4\" data-kid=\"1-2-2-1-1\" data-name=\"landing header\">\n                    <div data-kid=\"1-2-2-1-1-1\" data-name=\"landing subtitle container\">\n                        <p class=\"js-mono text-[10px] uppercase tracking-[0.2em] text-[var(--js-blue)]\" data-kid=\"1-2-2-1-1-1-1\" data-name=\"landing step label\">\n                            01 / first check\n                        </p>\n                        <p class=\"mt-2 text-sm text-[var(--js-ink)]/65\" data-kid=\"1-2-2-1-1-1-2\" data-name=\"landing section description\">\n                            A careful starting point for students, freshers, and job seekers.\n                        </p>\n                    </div>\n                    <span class=\"js-mono hidden text-[10px] uppercase tracking-[0.15em] text-[var(--js-ink)]/55 sm:block\" data-kid=\"1-2-2-1-1-2\" data-name=\"landing step breadcrumb\">\n                        job posting → evidence → action\n                    </span>\n                </div>\n                <div class=\"grid grid-cols-1 gap-9 pt-8 lg:grid-cols-12 lg:gap-8\" data-kid=\"1-2-2-1-2\" data-name=\"landing body content\">\n                    <div class=\"flex min-h-[520px] flex-col justify-between border-l-2 border-[var(--js-blue)] pl-7 lg:col-span-7 lg:pl-8\" data-kid=\"1-2-2-1-2-1\" data-name=\"landing left column\">\n                        <div data-kid=\"1-2-2-1-2-1-1\" data-name=\"landing headline container\">\n                            <h1 class=\"js-display max-w-[700px] text-[clamp(3.7rem,6.6vw,6.6rem)] font-bold leading-[0.86] tracking-[-0.065em]\" data-kid=\"1-2-2-1-2-1-1-1\" data-name=\"landing headline\">\n                                Is This Job\n                                <br data-kid=\"1-2-2-1-2-1-1-1-1\" data-name=\"headline line break\"/>\n                                <span class=\"text-[var(--js-blue)]\" data-kid=\"1-2-2-1-2-1-1-1-2\" data-name=\"headline highlight\">\n                                    Really Safe?\n                                </span>\n                            </h1>\n                            <p class=\"mt-8 max-w-[620px] text-[19px] leading-7 text-[var(--js-ink)]/85\" data-kid=\"1-2-2-1-2-1-1-2\" data-name=\"landing summary text\">\n                                Use AI to analyze suspicious job postings and understand potential risk indicators before you apply.\n                            </p>\n                            <div class=\"mt-8 grid max-w-[470px] grid-cols-[auto_1fr] items-center gap-4\" data-kid=\"1-2-2-1-2-1-1-3\" data-name=\"landing action buttons container\">\n                                <a class=\"js-bracket js-bracket-rust inline-flex min-h-[50px] items-center bg-[var(--js-rust)] px-8 text-[13px] font-bold uppercase tracking-[0.14em] text-white\" data-kid=\"1-2-2-1-2-1-1-3-1\" data-name=\"analyze job button\" href=\"#analyze\">\n                                    Analyze a job\n                                    <span class=\"ml-3 text-[18px] leading-none\" data-kid=\"1-2-2-1-2-1-1-3-1-1\" data-name=\"analyze job button arrow\">\n                                        →\n                                    </span>\n                                </a>\n                                <a class=\"js-focus flex min-h-[50px] flex-col justify-center border-l border-[var(--js-rule)] pl-4\" data-kid=\"1-2-2-1-2-1-1-3-2\" data-name=\"how it works button\" href=\"#workflow\">\n                                    <span class=\"flex items-center gap-2 text-sm font-semibold\" data-kid=\"1-2-2-1-2-1-1-3-2-1\" data-name=\"how it works title\">\n                                        How It Works\n                                        <span class=\"text-[var(--js-rust)]\" data-kid=\"1-2-2-1-2-1-1-3-2-1-1\" data-name=\"how it works arrow\">\n                                            ↓\n                                        </span>\n                                    </span>\n                                    <span class=\"js-mono mt-1 text-[9px] uppercase tracking-[0.11em] text-[var(--js-ink)]/55\" data-kid=\"1-2-2-1-2-1-1-3-2-2\" data-name=\"how it works subtitle\">\n                                        See four steps below\n                                    </span>\n                                </a>\n                            </div>\n                        </div>\n                        <div class=\"mt-12 border-t border-[var(--js-rule)] pt-5\" data-kid=\"1-2-2-1-2-1-2\" data-name=\"landing workflow section\" id=\"workflow\">\n                            <div class=\"flex items-end justify-between gap-5\" data-kid=\"1-2-2-1-2-1-2-1\" data-name=\"landing workflow header\">\n                                <div data-kid=\"1-2-2-1-2-1-2-1-1\" data-name=\"workflow label container\">\n                                    <p class=\"js-mono text-[10px] uppercase tracking-[0.18em] text-[var(--js-ink)]/55\" data-kid=\"1-2-2-1-2-1-2-1-1-1\" data-name=\"workflow label\">\n                                        workflow\n                                    </p>\n                                    <p class=\"js-display mt-3 text-[18px] font-semibold tracking-[-0.02em] sm:text-[21px]\" data-kid=\"1-2-2-1-2-1-2-1-1-2\" data-name=\"workflow steps text\">\n                                        Paste\n                                        <span class=\"text-[var(--js-rust)]\" data-kid=\"1-2-2-1-2-1-2-1-1-2-1\" data-name=\"step arrow 1\">\n                                            →\n                                        </span>\n                                        Analyze\n                                        <span class=\"text-[var(--js-rust)]\" data-kid=\"1-2-2-1-2-1-2-1-1-2-2\" data-name=\"step arrow 2\">\n                                            →\n                                        </span>\n                                        Understand\n                                        <span class=\"text-[var(--js-rust)]\" data-kid=\"1-2-2-1-2-1-2-1-1-2-3\" data-name=\"step arrow 3\">\n                                            →\n                                        </span>\n                                        Verify\n                                    </p>\n                                </div>\n                                <div aria-hidden=\"true\" class=\"h-12 w-16 shrink-0 border-y-2 border-r-2 border-[var(--js-blue)]\" data-kid=\"1-2-2-1-2-1-2-1-2\" data-name=\"decorative workflow shape\">\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"lg:col-span-5\" data-kid=\"1-2-2-1-2-2\" data-name=\"landing right column\">\n                        <div class=\"mb-5 border-l-2 border-[var(--js-rust)] pl-4\" data-kid=\"1-2-2-1-2-2-1\" data-name=\"responsible use panel\">\n                            <p class=\"js-mono text-[10px] uppercase tracking-[0.16em] text-[var(--js-rust)]\" data-kid=\"1-2-2-1-2-2-1-1\" data-name=\"responsible use label\">\n                                responsible use\n                            </p>\n                            <div class=\"mt-2 grid grid-cols-3 gap-3 text-[12px] font-semibold leading-4\" data-kid=\"1-2-2-1-2-2-1-2\" data-name=\"responsible use points grid\">\n                                <span data-kid=\"1-2-2-1-2-2-1-2-1\" data-name=\"point 1\">\n                                    AI-assisted\n                                    <br data-kid=\"1-2-2-1-2-2-1-2-1-1\" data-name=\"point 1 break\"/>\n                                    assessment\n                                </span>\n                                <span data-kid=\"1-2-2-1-2-2-1-2-2\" data-name=\"point 2\">\n                                    Not proof\n                                    <br data-kid=\"1-2-2-1-2-2-1-2-2-1\" data-name=\"point 2 break\"/>\n                                    of fraud\n                                </span>\n                                <span data-kid=\"1-2-2-1-2-2-1-2-3\" data-name=\"point 3\">\n                                    Always verify\n                                    <br data-kid=\"1-2-2-1-2-2-1-2-3-1\" data-name=\"point 3 break\"/>\n                                    independently\n                                </span>\n                            </div>\n                        </div>\n                        <div class=\"bg-[var(--js-source)] ring-1 ring-[var(--js-rule)]\" data-kid=\"1-2-2-1-2-2-2\" data-name=\"landing input panel\" data-source-shell=\"\">\n                            <div class=\"flex items-start justify-between gap-4 border-b border-[var(--js-rule)] px-6 py-5\" data-kid=\"1-2-2-1-2-2-2-1\" data-name=\"landing input header\">\n                                <div data-kid=\"1-2-2-1-2-2-2-1-1\" data-name=\"landing input title container\">\n                                    <p class=\"js-mono text-[10px] uppercase tracking-[0.18em] text-[var(--js-blue)]\" data-kid=\"1-2-2-1-2-2-2-1-1-1\" data-name=\"landing input label\">\n                                        source / input\n                                    </p>\n                                    <h2 class=\"js-display mt-2 text-[26px] font-bold tracking-[-0.035em]\" data-kid=\"1-2-2-1-2-2-2-1-1-2\" data-name=\"landing input heading\">\n                                        Start with a posting\n                                    </h2>\n                                </div>\n                                <span class=\"js-mono text-right text-[9px] uppercase leading-5 tracking-[0.12em] text-[var(--js-ink)]/55\" data-kid=\"1-2-2-1-2-2-2-1-2\" data-name=\"landing input format label\">\n                                    Text\n                                    <br data-kid=\"1-2-2-1-2-2-2-1-2-1\" data-name=\"input format break 1\"/>\n                                    Image\n                                    <br data-kid=\"1-2-2-1-2-2-2-1-2-2\" data-name=\"input format break 2\"/>\n                                    PDF / TXT\n                                </span>\n                            </div>\n                            <div class=\"px-6 py-5\" data-kid=\"1-2-2-1-2-2-2-2\" data-name=\"landing input methods\">\n                                <div class=\"grid grid-cols-3 border border-[var(--js-rule)] text-center text-[12px] font-semibold\" data-kid=\"1-2-2-1-2-2-2-2-1\" data-name=\"source input toggle\" data-source-group=\"landing\">\n                                    <button aria-pressed=\"true\" class=\"js-source-control js-focus min-h-[44px] px-2\" data-kid=\"1-2-2-1-2-2-2-2-1-1\" data-name=\"paste text button\" data-source=\"paste\" type=\"button\">\n                                        Paste text\n                                    </button>\n                                    <button aria-pressed=\"false\" class=\"js-source-control js-focus min-h-[44px] border-l border-[var(--js-rule)] px-2\" data-kid=\"1-2-2-1-2-2-2-2-1-2\" data-name=\"upload image button\" data-source=\"image\" type=\"button\">\n                                        Image\n                                    </button>\n                                    <button aria-pressed=\"false\" class=\"js-source-control js-focus min-h-[44px] border-l border-[var(--js-rule)] px-2\" data-kid=\"1-2-2-1-2-2-2-2-1-3\" data-name=\"upload document button\" data-source=\"document\" type=\"button\">\n                                        PDF / TXT\n                                    </button>\n                                </div>\n                                <div class=\"mt-5\" data-kid=\"1-2-2-1-2-2-2-2-2\" data-name=\"paste text panel\" data-source-panel=\"paste\">\n                                    <label class=\"block text-sm font-bold\" data-kid=\"1-2-2-1-2-2-2-2-2-1\" data-name=\"paste text label\" for=\"landing-paste\">\n                                        Paste Job Description Here\n                                    </label>\n                                    <textarea class=\"mt-2 h-[156px] w-full resize-none border border-[var(--js-rule)] bg-transparent p-4 text-sm leading-6 outline-none focus:border-[var(--js-blue)] focus:ring-2 focus:ring-[var(--js-blue)]/20\" data-kid=\"1-2-2-1-2-2-2-2-2-2\" data-name=\"paste text area\" id=\"landing-paste\" placeholder=\"Paste the job title, company details, and hiring message...\"></textarea>\n                                </div>\n                                <div class=\"mt-5 hidden\" data-kid=\"1-2-2-1-2-2-2-2-3\" data-name=\"upload image panel\" data-source-panel=\"image\">\n                                    <label class=\"js-upload-target flex min-h-[156px] cursor-pointer flex-col items-center justify-center px-5 text-center\" data-kid=\"1-2-2-1-2-2-2-2-3-1\" data-name=\"upload image target area\" for=\"landing-image\">\n                                        <span class=\"text-[22px] text-[var(--js-blue)]\" data-kid=\"1-2-2-1-2-2-2-2-3-1-1\" data-name=\"upload icon wrapper\">\n                                            <i aria-hidden=\"true\" class=\"ti ti-photo-search\" data-kid=\"1-2-2-1-2-2-2-2-3-1-1-1\" data-name=\"upload image icon\">\n                                            </i>\n                                        </span>\n                                        <span class=\"mt-2 text-sm font-bold\" data-kid=\"1-2-2-1-2-2-2-2-3-1-2\" data-name=\"upload image label\">\n                                            Upload a job screenshot\n                                        </span>\n                                        <span class=\"mt-1 text-xs text-[var(--js-ink)]/65\" data-kid=\"1-2-2-1-2-2-2-2-3-1-3\" data-name=\"upload image helper\">\n                                            JPG, JPEG, or PNG · file size limits apply\n                                        </span>\n                                        <input accept=\"image/jpeg,image/png\" class=\"sr-only\" data-kid=\"1-2-2-1-2-2-2-2-3-1-4\" data-name=\"image file input\" id=\"landing-image\" type=\"file\"/>\n                                    </label>\n                                </div>\n                                <div class=\"mt-5 hidden\" data-kid=\"1-2-2-1-2-2-2-2-4\" data-name=\"upload document panel\" data-source-panel=\"document\">\n                                    <label class=\"js-upload-target flex min-h-[156px] cursor-pointer flex-col items-center justify-center px-5 text-center\" data-kid=\"1-2-2-1-2-2-2-2-4-1\" data-name=\"upload document target area\" for=\"landing-document\">\n                                        <span class=\"text-[22px] text-[var(--js-blue)]\" data-kid=\"1-2-2-1-2-2-2-2-4-1-1\" data-name=\"document icon wrapper\">\n                                            <i aria-hidden=\"true\" class=\"ti ti-file-upload\" data-kid=\"1-2-2-1-2-2-2-2-4-1-1-1\" data-name=\"upload document icon\">\n                                            </i>\n                                        </span>\n                                        <span class=\"mt-2 text-sm font-bold\" data-kid=\"1-2-2-1-2-2-2-2-4-1-2\" data-name=\"upload document label\">\n                                            Upload a job document\n                                        </span>\n                                        <span class=\"mt-1 text-xs text-[var(--js-ink)]/65\" data-kid=\"1-2-2-1-2-2-2-2-4-1-3\" data-name=\"upload document helper\">\n                                            TXT or PDF · extracted text stays editable\n                                        </span>\n                                        <input accept=\".txt,.pdf,text/plain,application/pdf\" class=\"sr-only\" data-kid=\"1-2-2-1-2-2-2-2-4-1-4\" data-name=\"document file input\" id=\"landing-document\" type=\"file\"/>\n                                    </label>\n                                </div>\n                                <div class=\"mt-4 flex items-start gap-3 border-l-2 border-[var(--js-rust)] pl-3 text-xs leading-5 text-[var(--js-ink)]/75\" data-kid=\"1-2-2-1-2-2-2-2-5\" data-name=\"privacy notice container\">\n                                    <span class=\"text-[16px] text-[var(--js-rust)]\" data-kid=\"1-2-2-1-2-2-2-2-5-1\" data-name=\"privacy icon\">\n                                        <i aria-hidden=\"true\" class=\"ti ti-clipboard-check\" data-kid=\"1-2-2-1-2-2-2-2-5-1-1\" data-name=\"privacy icon i\">\n                                        </i>\n                                    </span>\n                                    <span data-kid=\"1-2-2-1-2-2-2-2-5-2\" data-name=\"privacy notice text\">\n                                        <strong class=\"text-[var(--js-ink)]\" data-kid=\"1-2-2-1-2-2-2-2-5-2-1\" data-name=\"privacy notice bold\">\n                                            Preliminary only.\n                                        </strong>\n                                        JobShield AI does not verify employers or store unnecessary upload content.\n                                    </span>\n                                </div>\n                                <a class=\"js-bracket js-bracket-rust mt-5 flex min-h-[50px] items-center justify-center bg-[var(--js-rust)] px-5 text-[13px] font-bold uppercase tracking-[0.14em] text-white\" data-kid=\"1-2-2-1-2-2-2-2-6\" data-name=\"analyze button\" href=\"#analyze\">\n                                    Analyze a job\n                                    <span class=\"ml-3 text-[18px] leading-none\" data-kid=\"1-2-2-1-2-2-2-2-6-1\" data-name=\"analyze button arrow\">\n                                        →\n                                    </span>\n                                </a>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </section>\n            <section class=\"border-b border-[var(--js-rule)] py-10\" data-kid=\"1-2-2-2\" data-name=\"features section\" id=\"features\">\n                <div class=\"flex items-end justify-between gap-6\" data-kid=\"1-2-2-2-1\" data-name=\"features section header\">\n                    <div data-kid=\"1-2-2-2-1-1\" data-name=\"features section title container\">\n                        <p class=\"js-mono text-[10px] uppercase tracking-[0.2em] text-[var(--js-blue)]\" data-kid=\"1-2-2-2-1-1-1\" data-name=\"features section label\">\n                            the field guide principle\n                        </p>\n                        <h2 class=\"js-display mt-2 text-3xl font-bold tracking-[-0.04em]\" data-kid=\"1-2-2-2-1-1-2\" data-name=\"features section heading\">\n                            Read the signals. Then verify.\n                        </h2>\n                    </div>\n                    <p class=\"hidden max-w-[330px] text-right text-sm leading-5 text-[var(--js-ink)]/70 sm:block\" data-kid=\"1-2-2-2-1-2\" data-name=\"features section description\">\n                        The product connects a posting’s own language to clear, practical next steps.\n                    </p>\n                </div>\n                <div class=\"mt-7 grid grid-cols-1 border-y border-[var(--js-rule)] md:grid-cols-[1fr_1.18fr_1fr]\" data-kid=\"1-2-2-2-2\" data-name=\"features grid\">\n                    <article class=\"js-feature-inspect border-b border-[var(--js-rule)] px-6 py-6 md:border-b-0 md:border-r\" data-kid=\"1-2-2-2-2-1\" data-name=\"feature 1 container\">\n                        <span class=\"text-[21px] text-[var(--js-blue)]\" data-kid=\"1-2-2-2-2-1-1\" data-name=\"feature 1 icon\">\n                            <i aria-hidden=\"true\" class=\"ti ti-text-search\" data-kid=\"1-2-2-2-2-1-1-1\" data-name=\"feature 1 icon i\">\n                            </i>\n                        </span>\n                        <p class=\"js-mono mt-5 text-[10px] uppercase tracking-[0.16em] text-[var(--js-blue)]\" data-kid=\"1-2-2-2-2-1-2\" data-name=\"feature 1 label\">\n                            01 / inspect\n                        </p>\n                        <h3 class=\"js-display mt-2 text-2xl font-bold\" data-kid=\"1-2-2-2-2-1-3\" data-name=\"feature 1 heading\">\n                            AI Analysis\n                        </h3>\n                        <p class=\"mt-3 text-sm leading-5 text-[var(--js-ink)]/78\" data-kid=\"1-2-2-2-2-1-4\" data-name=\"feature 1 description\">\n                            Reviews wording and patterns using NLP, machine learning, and indicator rules.\n                        </p>\n                        <p class=\"mt-6 border-l-2 border-[var(--js-rule)] pl-3 text-sm italic text-[var(--js-ink)]/70\" data-kid=\"1-2-2-2-2-1-5\" data-name=\"feature 1 example\">\n                            “No prior experience is needed for high earnings.”\n                        </p>\n                    </article>\n                    <article class=\"js-feature-explain border-b border-[var(--js-rule)] px-6 py-6 md:border-b-0 md:border-r\" data-kid=\"1-2-2-2-2-2\" data-name=\"feature 2 container\">\n                        <span class=\"text-[21px] text-[var(--js-blue)]\" data-kid=\"1-2-2-2-2-2-1\" data-name=\"feature 2 icon\">\n                            <i aria-hidden=\"true\" class=\"ti ti-brackets\" data-kid=\"1-2-2-2-2-2-1-1\" data-name=\"feature 2 icon i\">\n                            </i>\n                        </span>\n                        <p class=\"js-mono mt-5 text-[10px] uppercase tracking-[0.16em] text-[var(--js-blue)]\" data-kid=\"1-2-2-2-2-2-2\" data-name=\"feature 2 label\">\n                            02 / explain\n                        </p>\n                        <h3 class=\"js-display mt-2 text-2xl font-bold\" data-kid=\"1-2-2-2-2-2-3\" data-name=\"feature 2 heading\">\n                            Risk Explanation\n                        </h3>\n                        <p class=\"mt-3 text-sm leading-5 text-[var(--js-ink)]/78\" data-kid=\"1-2-2-2-2-2-4\" data-name=\"feature 2 description\">\n                            Connects detected language to understandable reasons, without presenting a verdict.\n                        </p>\n                        <p class=\"mt-6 border-l-2 border-[var(--js-rule)] pl-3 text-sm italic text-[var(--js-ink)]/70\" data-kid=\"1-2-2-2-2-2-5\" data-name=\"feature 2 example\">\n                            “The request appears before any interview or employment step.”\n                        </p>\n                    </article>\n                    <article class=\"js-feature-guidance px-6 py-6\" data-kid=\"1-2-2-2-2-3\" data-name=\"feature 3 container\">\n                        <span class=\"text-[21px] text-[var(--js-blue)]\" data-kid=\"1-2-2-2-2-3-1\" data-name=\"feature 3 icon\">\n                            <i aria-hidden=\"true\" class=\"ti ti-clipboard-check\" data-kid=\"1-2-2-2-2-3-1-1\" data-name=\"feature 3 icon i\">\n                            </i>\n                        </span>\n                        <p class=\"js-mono mt-5 text-[10px] uppercase tracking-[0.16em] text-[var(--js-blue)]\" data-kid=\"1-2-2-2-2-3-2\" data-name=\"feature 3 label\">\n                            03 / respond\n                        </p>\n                        <h3 class=\"js-display mt-2 text-2xl font-bold\" data-kid=\"1-2-2-2-2-3-3\" data-name=\"feature 3 heading\">\n                            Safety Guidance\n                        </h3>\n                        <p class=\"mt-3 text-sm leading-5 text-[var(--js-ink)]/78\" data-kid=\"1-2-2-2-2-3-4\" data-name=\"feature 3 description\">\n                            Suggests checks before you pay, share details, or continue with a recruiter.\n                        </p>\n                        <p class=\"mt-6 border-l-2 border-[var(--js-rule)] pl-3 text-sm italic text-[var(--js-ink)]/70\" data-kid=\"1-2-2-2-2-3-5\" data-name=\"feature 3 example\">\n                            “Verify the official website and recruiter independently.”\n                        </p>\n                    </article>\n                </div>\n                <div class=\"mt-8 grid grid-cols-1 border-y border-[var(--js-rule)] sm:grid-cols-3\" data-kid=\"1-2-2-2-3\" data-name=\"demo features grid\">\n                    <div class=\"border-b border-[var(--js-rule)] px-5 py-4 sm:border-b-0 sm:border-r\" data-kid=\"1-2-2-2-3-1\" data-name=\"demo feature 1\">\n                        <span class=\"js-mono text-[10px] text-[var(--js-low)]\" data-kid=\"1-2-2-2-3-1-1\" data-name=\"demo feature 1 label\">\n                            DEMO 01 · LOWER RISK\n                        </span>\n                        <p class=\"mt-2 text-sm font-semibold\" data-kid=\"1-2-2-2-3-1-2\" data-name=\"demo feature 1 description\">\n                            Standard hiring process and company details.\n                        </p>\n                        <span class=\"js-mono mt-2 block text-[9px] uppercase text-[var(--js-ink)]/55\" data-kid=\"1-2-2-2-3-1-3\" data-name=\"demo feature 1 source\">\n                            Demo Data\n                        </span>\n                    </div>\n                    <div class=\"border-b border-[var(--js-rule)] px-5 py-4 sm:border-b-0 sm:border-r\" data-kid=\"1-2-2-2-3-2\" data-name=\"demo feature 2\">\n                        <span class=\"js-mono text-[10px] text-[var(--js-high)]\" data-kid=\"1-2-2-2-3-2-1\" data-name=\"demo feature 2 label\">\n                            DEMO 02 · HIGH RISK\n                        </span>\n                        <p class=\"mt-2 text-sm font-semibold\" data-kid=\"1-2-2-2-3-2-2\" data-name=\"demo feature 2 description\">\n                            Registration fee mentioned before an interview.\n                        </p>\n                        <span class=\"js-mono mt-2 block text-[9px] uppercase text-[var(--js-ink)]/55\" data-kid=\"1-2-2-2-3-2-3\" data-name=\"demo feature 2 source\">\n                            Demo Data\n                        </span>\n                    </div>\n                    <div class=\"px-5 py-4\" data-kid=\"1-2-2-2-3-3\" data-name=\"demo feature 3\">\n                        <span class=\"js-mono text-[10px] text-[var(--js-very-high)]\" data-kid=\"1-2-2-2-3-3-1\" data-name=\"demo feature 3 label\">\n                            DEMO 03 · VERY HIGH RISK\n                        </span>\n                        <p class=\"mt-2 text-sm font-semibold\" data-kid=\"1-2-2-2-3-3-2\" data-name=\"demo feature 3 description\">\n                            High income promise paired with urgent payment language.\n                        </p>\n                        <span class=\"js-mono mt-2 block text-[9px] uppercase text-[var(--js-ink)]/55\" data-kid=\"1-2-2-2-3-3-3\" data-name=\"demo feature 3 source\">\n                            Demo Data\n                        </span>\n                    </div>\n                </div>\n            </section>\n            <section class=\"scroll-mt-24 border-b-2 border-[var(--js-ink)] py-10\" data-kid=\"1-2-2-3\" data-name=\"analyze section\" id=\"analyze\">\n                <div class=\"flex flex-wrap items-end justify-between gap-5 border-b-2 border-[var(--js-ink)] pb-5\" data-kid=\"1-2-2-3-1\" data-name=\"analyze section header\">\n                    <div data-kid=\"1-2-2-3-1-1\" data-name=\"analyze section title container\">\n                        <p class=\"js-mono text-[10px] uppercase tracking-[0.2em] text-[var(--js-blue)]\" data-kid=\"1-2-2-3-1-1-1\" data-name=\"analyze section label\">\n                            02 / input review\n                        </p>\n                        <h2 class=\"js-display mt-3 text-5xl font-bold tracking-[-0.05em]\" data-kid=\"1-2-2-3-1-1-2\" data-name=\"analyze section heading\">\n                            Analyze a job\n                        </h2>\n                    </div>\n                    <p class=\"max-w-[350px] text-right text-sm leading-5 text-[var(--js-ink)]/70\" data-kid=\"1-2-2-3-1-2\" data-name=\"analyze section description\">\n                        Enter the details you know, review extracted text, then explicitly start the assessment.\n                    </p>\n                </div>\n                <div class=\"mt-7 grid grid-cols-1 gap-8 lg:grid-cols-[0.72fr_1.28fr]\" data-kid=\"1-2-2-3-2\" data-name=\"analyze section body\">\n                    <div class=\"border-y border-[var(--js-rule)] py-5\" data-kid=\"1-2-2-3-2-1\" data-name=\"analyze job details form\">\n                        <div class=\"flex items-center justify-between\" data-kid=\"1-2-2-3-2-1-1\" data-name=\"form heading container\">\n                            <h3 class=\"js-display text-2xl font-bold\" data-kid=\"1-2-2-3-2-1-1-1\" data-name=\"form heading\">\n                                Job details\n                            </h3>\n                            <span class=\"js-mono text-[10px] uppercase tracking-[0.12em] text-[var(--js-ink)]/55\" data-kid=\"1-2-2-3-2-1-1-2\" data-name=\"form steps label\">\n                                01—04\n                            </span>\n                        </div>\n                        <div class=\"mt-6 space-y-5\" data-kid=\"1-2-2-3-2-1-2\" data-name=\"form fields\">\n                            <div data-kid=\"1-2-2-3-2-1-2-1\" data-name=\"job title field\">\n                                <label class=\"block text-[12px] font-bold\" data-kid=\"1-2-2-3-2-1-2-1-1\" data-name=\"job title label\" for=\"job-title\">\n                                    Job title\n                                </label>\n                                <input class=\"mt-2 min-h-[44px] w-full border border-[var(--js-rule)] bg-transparent px-3 text-sm outline-none focus:border-[var(--js-blue)] focus:ring-2 focus:ring-[var(--js-blue)]/20\" data-kid=\"1-2-2-3-2-1-2-1-2\" data-name=\"job title input\" id=\"job-title\" value=\"Customer Support Associate\"/>\n                            </div>\n                            <div data-kid=\"1-2-2-3-2-1-2-2\" data-name=\"company name field\">\n                                <label class=\"block text-[12px] font-bold\" data-kid=\"1-2-2-3-2-1-2-2-1\" data-name=\"company name label\" for=\"company-name\">\n                                    Company name\n                                </label>\n                                <input class=\"mt-2 min-h-[44px] w-full border border-[var(--js-rule)] bg-transparent px-3 text-sm outline-none focus:border-[var(--js-blue)] focus:ring-2 focus:ring-[var(--js-blue)]/20\" data-kid=\"1-2-2-3-2-1-2-2-2\" data-name=\"company name input\" id=\"company-name\" value=\"BrightPath Careers\"/>\n                            </div>\n                            <div data-kid=\"1-2-2-3-2-1-2-3\" data-name=\"company website field\">\n                                <label class=\"block text-[12px] font-bold\" data-kid=\"1-2-2-3-2-1-2-3-1\" data-name=\"company website label\" for=\"company-site\">\n                                    Company website\n                                    <span class=\"font-normal text-[var(--js-ink)]/55\" data-kid=\"1-2-2-3-2-1-2-3-1-1\" data-name=\"company website optional label\">\n                                        optional\n                                    </span>\n                                </label>\n                                <input class=\"mt-2 min-h-[44px] w-full border border-[var(--js-rule)] bg-transparent px-3 text-sm outline-none focus:border-[var(--js-blue)] focus:ring-2 focus:ring-[var(--js-blue)]/20\" data-kid=\"1-2-2-3-2-1-2-3-2\" data-name=\"company website input\" id=\"company-site\" placeholder=\"https://company.example\"/>\n                            </div>\n                            <div data-kid=\"1-2-2-3-2-1-2-4\" data-name=\"recruiter info field\">\n                                <label class=\"block text-[12px] font-bold\" data-kid=\"1-2-2-3-2-1-2-4-1\" data-name=\"recruiter info label\" for=\"recruiter-info\">\n                                    Recruiter information\n                                    <span class=\"font-normal text-[var(--js-ink)]/55\" data-kid=\"1-2-2-3-2-1-2-4-1-1\" data-name=\"recruiter info optional label\">\n                                        optional\n                                    </span>\n                                </label>\n                                <input class=\"mt-2 min-h-[44px] w-full border border-[var(--js-rule)] bg-transparent px-3 text-sm outline-none focus:border-[var(--js-blue)] focus:ring-2 focus:ring-[var(--js-blue)]/20\" data-kid=\"1-2-2-3-2-1-2-4-2\" data-name=\"recruiter info input\" id=\"recruiter-info\" placeholder=\"Name, email, or contact channel\"/>\n                            </div>\n                        </div>\n                        <div class=\"mt-7 border-t border-[var(--js-rule)] pt-5\" data-kid=\"1-2-2-3-2-1-3\" data-name=\"analyze input source selection\">\n                            <p class=\"js-mono text-[10px] uppercase tracking-[0.15em] text-[var(--js-blue)]\" data-kid=\"1-2-2-3-2-1-3-1\" data-name=\"analyze input source label\">\n                                input source\n                            </p>\n                            <div class=\"mt-3 grid grid-cols-3 border border-[var(--js-rule)] text-center text-[11px] font-semibold\" data-kid=\"1-2-2-3-2-1-3-2\" data-name=\"analyze input toggle\">\n                                <button aria-pressed=\"true\" class=\"js-source-control js-focus min-h-[44px] bg-[var(--js-ink)] px-2 text-[var(--js-source)]\" data-kid=\"1-2-2-3-2-1-3-2-1\" data-name=\"paste text toggle\" type=\"button\">\n                                    Paste\n                                </button>\n                                <button aria-pressed=\"false\" class=\"js-source-control js-focus min-h-[44px] border-l border-[var(--js-rule)] px-2\" data-kid=\"1-2-2-3-2-1-3-2-2\" data-name=\"upload image toggle\" type=\"button\">\n                                    Image\n                                </button>\n                                <button aria-pressed=\"false\" class=\"js-source-control js-focus min-h-[44px] border-l border-[var(--js-rule)] px-2\" data-kid=\"1-2-2-3-2-1-3-2-3\" data-name=\"upload document toggle\" type=\"button\">\n                                    PDF / TXT\n                                </button>\n                            </div>\n                            <p class=\"mt-3 text-xs leading-5 text-[var(--js-ink)]/68\" data-kid=\"1-2-2-3-2-1-3-3\" data-name=\"analyze input helper\">\n                                Accepted image types: JPG, JPEG, PNG. Accepted documents: PDF, TXT.\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"bg-[var(--js-source)] ring-1 ring-[var(--js-rule)]\" data-kid=\"1-2-2-3-2-2\" data-name=\"analyze job content panel\" data-source-shell=\"\">\n                        <div class=\"flex flex-wrap items-start justify-between gap-4 border-b border-[var(--js-rule)] px-6 py-5\" data-kid=\"1-2-2-3-2-2-1\" data-name=\"analyze content header\">\n                            <div data-kid=\"1-2-2-3-2-2-1-1\" data-name=\"analyze content label\">\n                                <p class=\"js-mono text-[10px] uppercase tracking-[0.18em] text-[var(--js-blue)]\" data-kid=\"1-2-2-3-2-2-1-1-1\" data-name=\"analyze content subtitle\">\n                                    content / review before run\n                                </p>\n                                <h3 class=\"js-display mt-2 text-2xl font-bold\" data-kid=\"1-2-2-3-2-2-1-1-2\" data-name=\"analyze content title\">\n                                    Posting content\n                                </h3>\n                            </div>\n                            <span class=\"js-mono text-[10px] uppercase tracking-[0.12em] text-[var(--js-ink)]/55\" data-kid=\"1-2-2-3-2-2-1-2\" data-name=\"analyze content status label\">\n                                Extracted text · editable\n                            </span>\n                        </div>\n                        <div class=\"px-6 py-5\" data-kid=\"1-2-2-3-2-2-2\" data-name=\"analyze input methods\">\n                            <div class=\"grid max-w-[430px] grid-cols-3 border border-[var(--js-rule)] text-center text-[11px] font-semibold\" data-kid=\"1-2-2-3-2-2-2-1\" data-name=\"analyze source toggle\" data-source-group=\"analyze\">\n                                <button aria-pressed=\"true\" class=\"js-source-control js-focus min-h-[42px] px-2\" data-kid=\"1-2-2-3-2-2-2-1-1\" data-name=\"analyze paste text button\" data-source=\"paste\" type=\"button\">\n                                    Paste text\n                                </button>\n                                <button aria-pressed=\"false\" class=\"js-source-control js-focus min-h-[42px] border-l border-[var(--js-rule)] px-2\" data-kid=\"1-2-2-3-2-2-2-1-2\" data-name=\"analyze upload image button\" data-source=\"image\" type=\"button\">\n                                    Image\n                                </button>\n                                <button aria-pressed=\"false\" class=\"js-source-control js-focus min-h-[42px] border-l border-[var(--js-rule)] px-2\" data-kid=\"1-2-2-3-2-2-2-1-3\" data-name=\"analyze upload document button\" data-source=\"document\" type=\"button\">\n                                    PDF / TXT\n                                </button>\n                            </div>\n                            <div class=\"mt-5\" data-kid=\"1-2-2-3-2-2-2-2\" data-name=\"analyze paste text panel\" data-source-panel=\"paste\">\n                                <label class=\"block text-sm font-bold\" data-kid=\"1-2-2-3-2-2-2-2-1\" data-name=\"analyze text label\" for=\"extracted-text\">\n                                    Extracted text\n                                </label>\n                                <textarea class=\"mt-2 h-[238px] w-full resize-y border border-[var(--js-rule)] bg-transparent p-4 text-[13px] leading-6 outline-none focus:border-[var(--js-blue)] focus:ring-2 focus:ring-[var(--js-blue)]/20\" data-kid=\"1-2-2-3-2-2-2-2-2\" data-name=\"analyze text area\" id=\"extracted-text\">We are seeking motivated students and freshers for flexible online work. No prior experience is needed and successful applicants can earn high income, no experience. To reserve your interview slot, a refundable registration fee is required. Send your details to our coordinator and pay today to begin. Limited places available.</textarea>\n                            </div>\n                            <div class=\"mt-5 hidden\" data-kid=\"1-2-2-3-2-2-2-3\" data-name=\"analyze upload image panel\" data-source-panel=\"image\">\n                                <label class=\"js-upload-target flex min-h-[238px] cursor-pointer flex-col items-center justify-center px-5 text-center\" data-kid=\"1-2-2-3-2-2-2-3-1\" data-name=\"analyze upload image target\" for=\"analyze-image\">\n                                    <span class=\"text-[22px] text-[var(--js-blue)]\" data-kid=\"1-2-2-3-2-2-2-3-1-1\" data-name=\"analyze image icon wrapper\">\n                                        <i aria-hidden=\"true\" class=\"ti ti-photo-search\" data-kid=\"1-2-2-3-2-2-2-3-1-1-1\" data-name=\"analyze image icon\">\n                                        </i>\n                                    </span>\n                                    <span class=\"mt-2 text-sm font-bold\" data-kid=\"1-2-2-3-2-2-2-3-1-2\" data-name=\"analyze image label\">\n                                        Upload screenshot for text extraction\n                                    </span>\n                                    <span class=\"mt-1 text-xs text-[var(--js-ink)]/65\" data-kid=\"1-2-2-3-2-2-2-3-1-3\" data-name=\"analyze image helper\">\n                                        JPG, JPEG, PNG · OCR text will appear for review\n                                    </span>\n                                    <input accept=\"image/jpeg,image/png\" class=\"sr-only\" data-kid=\"1-2-2-3-2-2-2-3-1-4\" data-name=\"analyze image input\" id=\"analyze-image\" type=\"file\"/>\n                                </label>\n                            </div>\n                            <div class=\"mt-5 hidden\" data-kid=\"1-2-2-3-2-2-2-4\" data-name=\"analyze upload document panel\" data-source-panel=\"document\">\n                                <label class=\"js-upload-target flex min-h-[238px] cursor-pointer flex-col items-center justify-center px-5 text-center\" data-kid=\"1-2-2-3-2-2-2-4-1\" data-name=\"analyze upload document target\" for=\"analyze-document\">\n                                    <span class=\"text-[22px] text-[var(--js-blue)]\" data-kid=\"1-2-2-3-2-2-2-4-1-1\" data-name=\"analyze doc icon wrapper\">\n                                        <i aria-hidden=\"true\" class=\"ti ti-file-upload\" data-kid=\"1-2-2-3-2-2-2-4-1-1-1\" data-name=\"analyze doc icon\">\n                                        </i>\n                                    </span>\n                                    <span class=\"mt-2 text-sm font-bold\" data-kid=\"1-2-2-3-2-2-2-4-1-2\" data-name=\"analyze doc label\">\n                                        Upload PDF or TXT for extraction\n                                    </span>\n                                    <span class=\"mt-1 text-xs text-[var(--js-ink)]/65\" data-kid=\"1-2-2-3-2-2-2-4-1-3\" data-name=\"analyze doc helper\">\n                                        The extracted text remains editable before analysis.\n                                    </span>\n                                    <input accept=\".txt,.pdf,text/plain,application/pdf\" class=\"sr-only\" data-kid=\"1-2-2-3-2-2-2-4-1-4\" data-name=\"analyze doc input\" id=\"analyze-document\" type=\"file\"/>\n                                </label>\n                            </div>\n                            <div class=\"mt-5 flex items-start gap-3 border-t border-[var(--js-rule)] pt-4 text-xs leading-5 text-[var(--js-ink)]/72\" data-kid=\"1-2-2-3-2-2-2-5\" data-name=\"analyze privacy notice container\">\n                                <span class=\"text-[16px] text-[var(--js-blue)]\" data-kid=\"1-2-2-3-2-2-2-5-1\" data-name=\"analyze privacy icon\">\n                                    <i aria-hidden=\"true\" class=\"ti ti-lock\" data-kid=\"1-2-2-3-2-2-2-5-1-1\" data-name=\"analyze privacy icon i\">\n                                    </i>\n                                </span>\n                                <span data-kid=\"1-2-2-3-2-2-2-5-2\" data-name=\"analyze privacy notice\">\n                                    <strong class=\"text-[var(--js-ink)]\" data-kid=\"1-2-2-3-2-2-2-5-2-1\" data-name=\"analyze privacy bold\">\n                                        Privacy handling.\n                                    </strong>\n                                    Validate file type and size, sanitize input, clean up temporary uploads, and do not submit passwords, OTPs, card details, or banking credentials.\n                                </span>\n                            </div>\n                            <div class=\"mt-6 flex justify-end\" data-kid=\"1-2-2-3-2-2-2-6\" data-name=\"run analyze button\">\n                                <button class=\"js-bracket js-bracket-rust js-focus min-h-[50px] bg-[var(--js-rust)] px-8 text-[13px] font-bold uppercase tracking-[0.14em] text-white\" data-kid=\"1-2-2-3-2-2-2-6-1\" data-name=\"run analyze button arrow\" type=\"button\">\n                                    Analyze job\n                                    <span class=\"ml-3 text-[18px] leading-none\" data-kid=\"1-2-2-3-2-2-2-6-1-1\">\n                                        →\n                                    </span>\n                                </button>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"mt-6 flex items-center gap-3 border-l-2 border-[var(--js-blue)] pl-4 text-xs leading-5 text-[var(--js-ink)]/72\" data-kid=\"1-2-2-3-3\" data-name=\"pipeline step list\">\n                    <span class=\"js-mono text-[10px] uppercase tracking-[0.12em] text-[var(--js-blue)]\" data-kid=\"1-2-2-3-3-1\" data-name=\"pipeline label\">\n                        pipeline\n                    </span>\n                    <span data-kid=\"1-2-2-3-3-2\" data-name=\"pipeline description\">\n                        Text extraction → preprocessing → features → model → risk score → indicators → explanation\n                    </span>\n                </div>\n            </section>\n            <section class=\"scroll-mt-24 border-b-2 border-[var(--js-ink)] py-10\" data-kid=\"1-2-2-4\" data-name=\"risk summary section\" id=\"report\">\n                <div class=\"flex flex-col gap-5 border-b-2 border-[var(--js-ink)] pb-5 xl:flex-row xl:items-end xl:justify-between\" data-kid=\"1-2-2-4-1\" data-name=\"risk summary header\">\n                    <div data-kid=\"1-2-2-4-1-1\" data-name=\"risk summary title container\">\n                        <p class=\"js-mono text-[10px] uppercase tracking-[0.2em] text-[var(--js-blue)]\" data-kid=\"1-2-2-4-1-1-1\" data-name=\"risk summary label\">\n                            03 / explainable result · Demo Data\n                        </p>\n                        <h2 class=\"js-display mt-3 text-5xl font-bold tracking-[-0.05em]\" data-kid=\"1-2-2-4-1-1-2\" data-name=\"risk summary heading\">\n                            Risk summary\n                        </h2>\n                    </div>\n                    <div class=\"js-bracket px-8 py-3 text-right\" data-kid=\"1-2-2-4-1-2\" data-name=\"risk score display\">\n                        <div class=\"js-mono text-[clamp(2.6rem,4vw,4.7rem)] leading-none font-bold text-[var(--js-very-high)]\" data-kid=\"1-2-2-4-1-2-1\" data-name=\"risk score number\">\n                            87 / 100\n                        </div>\n                        <div class=\"mt-2 text-sm font-bold text-[var(--js-very-high)]\" data-kid=\"1-2-2-4-1-2-2\" data-name=\"risk score status\">\n                            Very High risk · Potentially suspicious\n                        </div>\n                    </div>\n                </div>\n                <div class=\"grid grid-cols-1 gap-4 border-b border-[var(--js-rule)] py-4 sm:grid-cols-[1fr_auto] sm:items-center\" data-kid=\"1-2-2-4-2\" data-name=\"risk summary description\">\n                    <p class=\"max-w-[670px] text-sm leading-5 text-[var(--js-ink)]/82\" data-kid=\"1-2-2-4-2-1\" data-name=\"risk summary text\">\n                        This posting contains several signals that warrant extra verification before you continue.\n                    </p>\n                    <div class=\"js-mono text-left text-[9px] uppercase leading-5 tracking-[0.13em] text-[var(--js-ink)]/60 sm:text-right\" data-kid=\"1-2-2-4-2-2\" data-name=\"risk summary disclaimer\">\n                        AI-assisted risk assessment\n                        <br data-kid=\"1-2-2-4-2-2-1\" data-name=\"risk summary disclaimer line break\"/>\n                        Confidence is unavailable for this assessment.\n                    </div>\n                </div>\n                <div class=\"relative mt-8 grid grid-cols-1 gap-10 xl:grid-cols-[1.18fr_0.82fr] xl:gap-9\" data-kid=\"1-2-2-4-3\" data-name=\"risk summary body\">\n                    <article class=\"bg-[var(--js-source)] ring-1 ring-[var(--js-rule)]\" data-kid=\"1-2-2-4-3-1\" data-name=\"risk summary posting card\">\n                        <div class=\"flex items-start justify-between gap-4 border-b border-[var(--js-rule)] px-6 py-5 sm:px-7\" data-kid=\"1-2-2-4-3-1-1\" data-name=\"posting card header\">\n                            <div data-kid=\"1-2-2-4-3-1-1-1\" data-name=\"posting card info\">\n                                <span class=\"js-mono text-[10px] uppercase tracking-[0.15em] text-[var(--js-blue)]\" data-kid=\"1-2-2-4-3-1-1-1-1\" data-name=\"posting card label\">\n                                    source sheet / posting-0248\n                                </span>\n                                <h3 class=\"js-display mt-2 text-2xl font-bold\" data-kid=\"1-2-2-4-3-1-1-1-2\" data-name=\"posting card title\">\n                                    Customer Support Associate\n                                </h3>\n                                <p class=\"mt-1 text-sm text-[var(--js-ink)]/65\" data-kid=\"1-2-2-4-3-1-1-1-3\" data-name=\"posting card details\">\n                                    BrightPath Careers · Remote · Entry level\n                                </p>\n                            </div>\n                            <span class=\"js-mono text-right text-[9px] uppercase leading-5 tracking-[0.1em] text-[var(--js-ink)]/55\" data-kid=\"1-2-2-4-3-1-1-2\" data-name=\"posting card page meta\">\n                                Demo Data\n                                <br data-kid=\"1-2-2-4-3-1-1-2-1\" data-name=\"posting card line break\"/>\n                                p. 01 / 01\n                            </span>\n                        </div>\n                        <div class=\"px-6 py-6 text-[15px] leading-7 sm:px-7\" data-kid=\"1-2-2-4-3-1-2\" data-name=\"posting card content\">\n                            <p data-kid=\"1-2-2-4-3-1-2-1\" data-name=\"posting card text 1\">\n                                We are seeking motivated students and freshers for flexible online work. No prior experience is needed and successful applicants can earn\n                                <button class=\"js-evidence-highlight js-focus\" data-evidence=\"02\" data-kid=\"1-2-2-4-3-1-2-1-1\" data-name=\"posting evidence highlight 2\" type=\"button\">\n                                    high income, no experience\n                                    <sup class=\"js-mono ml-1 text-[9px]\" data-kid=\"1-2-2-4-3-1-2-1-1-1\" data-name=\"evidence superscript 02\">\n                                        02\n                                    </sup>\n                                </button>\n                                .\n                            </p>\n                            <p class=\"mt-5\" data-kid=\"1-2-2-4-3-1-2-2\" data-name=\"posting card text 2\">\n                                To reserve your interview slot, a refundable\n                                <button class=\"js-evidence-highlight js-focus\" data-evidence=\"01\" data-kid=\"1-2-2-4-3-1-2-2-1\" data-name=\"posting evidence highlight 1\" type=\"button\">\n                                    registration fee\n                                    <sup class=\"js-mono ml-1 text-[9px]\" data-kid=\"1-2-2-4-3-1-2-2-1-1\" data-name=\"evidence superscript 01\">\n                                        01\n                                    </sup>\n                                </button>\n                                is required. Send your details to our coordinator and\n                                <button class=\"js-evidence-highlight js-focus\" data-evidence=\"03\" data-kid=\"1-2-2-4-3-1-2-2-2\" data-name=\"posting evidence highlight 3\" type=\"button\">\n                                    pay today\n                                    <sup class=\"js-mono ml-1 text-[9px]\" data-kid=\"1-2-2-4-3-1-2-2-2-1\" data-name=\"evidence superscript 03\">\n                                        03\n                                    </sup>\n                                </button>\n                                to begin.\n                            </p>\n                            <p class=\"mt-5\" data-kid=\"1-2-2-4-3-1-2-3\" data-name=\"posting card text 3\">\n                                Limited places available. Further company information will be shared after confirmation.\n                            </p>\n                        </div>\n                        <div class=\"grid grid-cols-1 border-t border-[var(--js-rule)] px-6 py-4 text-[10px] sm:grid-cols-2 sm:px-7\" data-kid=\"1-2-2-4-3-1-3\" data-name=\"posting card footer\">\n                            <span class=\"js-mono text-[var(--js-ink)]/55\" data-kid=\"1-2-2-4-3-1-3-1\" data-name=\"posting card input type\">\n                                Input: pasted text · extracted text editable\n                            </span>\n                            <span class=\"js-mono mt-2 text-[var(--js-ink)]/55 sm:mt-0 sm:text-right\" data-kid=\"1-2-2-4-3-1-3-2\" data-name=\"posting card date\">\n                                24 Jun 2026 · source retained for review\n                            </span>\n                        </div>\n                    </article>\n                    <aside class=\"min-w-0\" data-kid=\"1-2-2-4-3-2\" data-name=\"evidence sidebar\">\n                        <div class=\"mb-3 flex items-end justify-between gap-4\" data-kid=\"1-2-2-4-3-2-1\" data-name=\"evidence sidebar header\">\n                            <div data-kid=\"1-2-2-4-3-2-1-1\" data-name=\"evidence sidebar title container\">\n                                <p class=\"js-mono text-[10px] uppercase tracking-[0.16em] text-[var(--js-blue)]\" data-kid=\"1-2-2-4-3-2-1-1-1\" data-name=\"evidence sidebar label\">\n                                    right margin / linked findings\n                                </p>\n                                <h3 class=\"js-display mt-2 text-2xl font-bold\" data-kid=\"1-2-2-4-3-2-1-1-2\" data-name=\"evidence sidebar heading\">\n                                    Evidence found\n                                </h3>\n                            </div>\n                            <span class=\"js-mono text-[9px] uppercase tracking-[0.12em] text-[var(--js-ink)]/55\" data-kid=\"1-2-2-4-3-2-1-2\" data-name=\"evidence sidebar count\">\n                                3 notes\n                            </span>\n                        </div>\n                        <div class=\"border-t border-[var(--js-rule)]\" data-kid=\"1-2-2-4-3-2-2\" data-name=\"evidence note list\">\n                            <div class=\"js-evidence-note is-active border-b border-[var(--js-rule)] py-5 pl-4 pr-2\" data-kid=\"1-2-2-4-3-2-2-1\" data-name=\"evidence note 1\" data-note=\"01\">\n                                <button class=\"js-focus flex w-full gap-3 text-left\" data-evidence=\"01\" data-kid=\"1-2-2-4-3-2-2-1-1\" data-name=\"evidence note 1 button\" type=\"button\">\n                                    <span class=\"js-mono text-[13px] font-bold text-[var(--js-very-high)]\" data-kid=\"1-2-2-4-3-2-2-1-1-1\" data-name=\"evidence note 1 label\">\n                                        01\n                                    </span>\n                                    <span data-kid=\"1-2-2-4-3-2-2-1-1-2\" data-name=\"evidence note 1 details\">\n                                        <span class=\"js-mono block text-[9px] uppercase tracking-[0.13em] text-[var(--js-very-high)]\" data-kid=\"1-2-2-4-3-2-2-1-1-2-1\" data-name=\"evidence note 1 category\">\n                                            Financial requests\n                                        </span>\n                                        <strong class=\"mt-2 block text-[13px]\" data-kid=\"1-2-2-4-3-2-2-1-1-2-2\" data-name=\"evidence note 1 title\">\n                                            Matched phrase: “registration fee”\n                                        </strong>\n                                        <span class=\"mt-2 block text-sm leading-5 text-[var(--js-ink)]/75\" data-kid=\"1-2-2-4-3-2-2-1-1-2-3\" data-name=\"evidence note 1 description\">\n                                            The posting asks for payment before an interview.\n                                        </span>\n                                    </span>\n                                </button>\n                            </div>\n                            <div class=\"js-evidence-note border-b border-[var(--js-rule)] py-5 pl-4 pr-2\" data-kid=\"1-2-2-4-3-2-2-2\" data-name=\"evidence note 2\" data-note=\"02\">\n                                <button class=\"js-focus flex w-full gap-3 text-left\" data-evidence=\"02\" data-kid=\"1-2-2-4-3-2-2-2-1\" data-name=\"evidence note 2 button\" type=\"button\">\n                                    <span class=\"js-mono text-[13px] font-bold text-[var(--js-high)]\" data-kid=\"1-2-2-4-3-2-2-2-1-1\" data-name=\"evidence note 2 label\">\n                                        02\n                                    </span>\n                                    <span data-kid=\"1-2-2-4-3-2-2-2-1-2\" data-name=\"evidence note 2 details\">\n                                        <span class=\"js-mono block text-[9px] uppercase tracking-[0.13em] text-[var(--js-high)]\" data-kid=\"1-2-2-4-3-2-2-2-1-2-1\" data-name=\"evidence note 2 category\">\n                                            Unrealistic claims\n                                        </span>\n                                        <strong class=\"mt-2 block text-[13px]\" data-kid=\"1-2-2-4-3-2-2-2-1-2-2\" data-name=\"evidence note 2 title\">\n                                            Matched phrase: “high income, no experience”\n                                        </strong>\n                                        <span class=\"mt-2 block text-sm leading-5 text-[var(--js-ink)]/75\" data-kid=\"1-2-2-4-3-2-2-2-1-2-3\" data-name=\"evidence note 2 description\">\n                                            The salary claim is unusually strong relative to the stated requirements.\n                                        </span>\n                                    </span>\n                                </button>\n                            </div>\n                            <div class=\"js-evidence-note border-b border-[var(--js-rule)] py-5 pl-4 pr-2\" data-kid=\"1-2-2-4-3-2-2-3\" data-name=\"evidence note 3\" data-note=\"03\">\n                                <button class=\"js-focus flex w-full gap-3 text-left\" data-evidence=\"03\" data-kid=\"1-2-2-4-3-2-2-3-1\" data-name=\"evidence note 3 button\" type=\"button\">\n                                    <span class=\"js-mono text-[13px] font-bold text-[var(--js-high)]\" data-kid=\"1-2-2-4-3-2-2-3-1-1\" data-name=\"evidence note 3 label\">\n                                        03\n                                    </span>\n                                    <span data-kid=\"1-2-2-4-3-2-2-3-1-2\" data-name=\"evidence note 3 details\">\n                                        <span class=\"js-mono block text-[9px] uppercase tracking-[0.13em] text-[var(--js-high)]\" data-kid=\"1-2-2-4-3-2-2-3-1-2-1\" data-name=\"evidence note 3 category\">\n                                            Urgency\n                                        </span>\n                                        <strong class=\"mt-2 block text-[13px]\" data-kid=\"1-2-2-4-3-2-2-3-1-2-2\" data-name=\"evidence note 3 title\">\n                                            Matched phrase: “pay today”\n                                        </strong>\n                                        <span class=\"mt-2 block text-sm leading-5 text-[var(--js-ink)]/75\" data-kid=\"1-2-2-4-3-2-2-3-1-2-3\" data-name=\"evidence note 3 description\">\n                                            Time-pressure language can reduce the opportunity to verify an employer.\n                                        </span>\n                                    </span>\n                                </button>\n                            </div>\n                        </div>\n                    </aside>\n                </div>\n                <div class=\"mt-9 border-t border-[var(--js-rule)] pt-7\" data-kid=\"1-2-2-4-4\" data-name=\"ai explanation panel\">\n                    <p class=\"js-mono text-[10px] uppercase tracking-[0.17em] text-[var(--js-blue)]\" data-kid=\"1-2-2-4-4-1\" data-name=\"ai explanation label\">\n                        interpretation\n                    </p>\n                    <h3 class=\"js-display mt-2 text-3xl font-bold tracking-[-0.035em]\" data-kid=\"1-2-2-4-4-2\" data-name=\"ai explanation heading\">\n                        AI explanation\n                    </h3>\n                    <p class=\"mt-3 max-w-[900px] text-[16px] leading-6\" data-kid=\"1-2-2-4-4-3\" data-name=\"ai explanation text\">\n                        Several characteristics commonly associated with suspicious job postings were detected. The posting requests payment before employment and contains unusually strong salary claims. Time-pressure language makes independent verification more important.\n                    </p>\n                </div>\n                <div class=\"mt-8 grid grid-cols-1 gap-8 lg:grid-cols-[1.12fr_0.88fr]\" data-kid=\"1-2-2-4-5\" data-name=\"assessment actions and details\">\n                    <div class=\"border-y border-[var(--js-rule)] py-5\" data-kid=\"1-2-2-4-5-1\" data-name=\"recommended actions panel\">\n                        <div class=\"flex items-end justify-between gap-4\" data-kid=\"1-2-2-4-5-1-1\" data-name=\"actions panel header\">\n                            <h3 class=\"js-display text-2xl font-bold\" data-kid=\"1-2-2-4-5-1-1-1\" data-name=\"actions panel heading\">\n                                Recommended actions\n                            </h3>\n                            <span class=\"js-mono text-[9px] uppercase tracking-[0.12em] text-[var(--js-ink)]/55\" data-kid=\"1-2-2-4-5-1-1-2\" data-name=\"actions panel reading aid\">\n                                reading aid · local only\n                            </span>\n                        </div>\n                        <div class=\"mt-4 divide-y divide-[var(--js-rule)] border-t border-[var(--js-rule)]\" data-kid=\"1-2-2-4-5-1-2\" data-name=\"recommended actions list\">\n                            <label class=\"flex min-h-[52px] items-center gap-3 text-sm\" data-kid=\"1-2-2-4-5-1-2-1\" data-name=\"action 1 label\">\n                                <input class=\"h-4 w-4 accent-[var(--js-blue)]\" data-kid=\"1-2-2-4-5-1-2-1-1\" data-name=\"action 1 checkbox\" type=\"checkbox\"/>\n                                <span data-kid=\"1-2-2-4-5-1-2-1-2\" data-name=\"action 1 text\">\n                                    Do not make upfront payments.\n                                </span>\n                            </label>\n                            <label class=\"flex min-h-[52px] items-center gap-3 text-sm\" data-kid=\"1-2-2-4-5-1-2-2\" data-name=\"action 2 label\">\n                                <input class=\"h-4 w-4 accent-[var(--js-blue)]\" data-kid=\"1-2-2-4-5-1-2-2-1\" data-name=\"action 2 checkbox\" type=\"checkbox\"/>\n                                <span data-kid=\"1-2-2-4-5-1-2-2-2\" data-name=\"action 2 text\">\n                                    Verify the official website and recruiter independently.\n                                </span>\n                            </label>\n                            <label class=\"flex min-h-[52px] items-center gap-3 text-sm\" data-kid=\"1-2-2-4-5-1-2-3\" data-name=\"action 3 label\">\n                                <input class=\"h-4 w-4 accent-[var(--js-blue)]\" data-kid=\"1-2-2-4-5-1-2-3-1\" data-name=\"action 3 checkbox\" type=\"checkbox\"/>\n                                <span data-kid=\"1-2-2-4-5-1-2-3-2\" data-name=\"action 3 text\">\n                                    Do not share OTP, passwords, or banking credentials.\n                                </span>\n                            </label>\n                            <label class=\"flex min-h-[52px] items-center gap-3 text-sm\" data-kid=\"1-2-2-4-5-1-2-4\" data-name=\"action 4 label\">\n                                <input class=\"h-4 w-4 accent-[var(--js-blue)]\" data-kid=\"1-2-2-4-5-1-2-4-1\" data-name=\"action 4 checkbox\" type=\"checkbox\"/>\n                                <span data-kid=\"1-2-2-4-5-1-2-4-2\" data-name=\"action 4 text\">\n                                    Compare the role with trusted recruitment platforms.\n                                </span>\n                            </label>\n                        </div>\n                    </div>\n                    <div class=\"border-y border-[var(--js-rule)] py-5\" data-kid=\"1-2-2-4-5-2\" data-name=\"assessment details panel\">\n                        <h3 class=\"js-display text-2xl font-bold\" data-kid=\"1-2-2-4-5-2-1\" data-name=\"assessment details heading\">\n                            Assessment details\n                        </h3>\n                        <dl class=\"mt-4 divide-y divide-[var(--js-rule)] border-t border-[var(--js-rule)] text-sm\" data-kid=\"1-2-2-4-5-2-2\" data-name=\"assessment attributes list\">\n                            <div class=\"flex justify-between gap-5 py-3\" data-kid=\"1-2-2-4-5-2-2-1\" data-name=\"assessment attr 1\">\n                                <dt class=\"text-[var(--js-ink)]/65\" data-kid=\"1-2-2-4-5-2-2-1-1\" data-name=\"assessment attr 1 label\">\n                                    Classification\n                                </dt>\n                                <dd class=\"font-semibold text-[var(--js-very-high)]\" data-kid=\"1-2-2-4-5-2-2-1-2\" data-name=\"assessment attr 1 value\">\n                                    Potentially suspicious\n                                </dd>\n                            </div>\n                            <div class=\"flex justify-between gap-5 py-3\" data-kid=\"1-2-2-4-5-2-2-2\" data-name=\"assessment attr 2\">\n                                <dt class=\"text-[var(--js-ink)]/65\" data-kid=\"1-2-2-4-5-2-2-2-1\" data-name=\"assessment attr 2 label\">\n                                    Indicators\n                                </dt>\n                                <dd class=\"font-semibold\" data-kid=\"1-2-2-4-5-2-2-2-2\" data-name=\"assessment attr 2 value\">\n                                    3 listed matches\n                                </dd>\n                            </div>\n                            <div class=\"flex justify-between gap-5 py-3\" data-kid=\"1-2-2-4-5-2-2-3\" data-name=\"assessment attr 3\">\n                                <dt class=\"text-[var(--js-ink)]/65\" data-kid=\"1-2-2-4-5-2-2-3-1\" data-name=\"assessment attr 3 label\">\n                                    Confidence\n                                </dt>\n                                <dd class=\"js-mono text-right text-[11px]\" data-kid=\"1-2-2-4-5-2-2-3-2\" data-name=\"assessment attr 3 value\">\n                                    Unavailable\n                                </dd>\n                            </div>\n                            <div class=\"flex justify-between gap-5 py-3\" data-kid=\"1-2-2-4-5-2-2-4\" data-name=\"assessment attr 4\">\n                                <dt class=\"text-[var(--js-ink)]/65\" data-kid=\"1-2-2-4-5-2-2-4-1\" data-name=\"assessment attr 4 label\">\n                                    Mode\n                                </dt>\n                                <dd class=\"js-mono text-[11px]\" data-kid=\"1-2-2-4-5-2-2-4-2\" data-name=\"assessment attr 4 value\">\n                                    Demo Data\n                                </dd>\n                            </div>\n                        </dl>\n                    </div>\n                </div>\n                <div class=\"mt-7 border-l-2 border-[var(--js-rust)] bg-[var(--js-source)] px-5 py-4 text-sm leading-5 ring-1 ring-[var(--js-rule)]\" data-kid=\"1-2-2-4-6\" data-name=\"disclaimer panel\">\n                    <strong data-kid=\"1-2-2-4-6-1\" data-name=\"disclaimer bold label\">\n                        Disclaimer.\n                    </strong>\n                    JobShield AI provides an AI-assisted preliminary risk assessment. It may produce false positives or false negatives. Always independently verify an employer before taking action.\n                </div>\n            </section>\n            <section class=\"scroll-mt-24 border-b-2 border-[var(--js-ink)] py-10\" data-kid=\"1-2-2-5\" data-name=\"dashboard section\" id=\"dashboard\">\n                <div class=\"flex flex-wrap items-end justify-between gap-6 border-b-2 border-[var(--js-ink)] pb-5\" data-kid=\"1-2-2-5-1\" data-name=\"dashboard header\">\n                    <div data-kid=\"1-2-2-5-1-1\" data-name=\"dashboard heading container\">\n                        <p class=\"js-mono text-[10px] uppercase tracking-[0.2em] text-[var(--js-blue)]\" data-kid=\"1-2-2-5-1-1-1\" data-name=\"dashboard label\">\n                            04 / field log · Demo Data\n                        </p>\n                        <h2 class=\"js-display mt-3 text-5xl font-bold tracking-[-0.05em]\" data-kid=\"1-2-2-5-1-1-2\" data-name=\"dashboard heading\">\n                            Dashboard\n                        </h2>\n                    </div>\n                    <p class=\"max-w-[370px] text-right text-sm leading-5 text-[var(--js-ink)]/70\" data-kid=\"1-2-2-5-1-2\" data-name=\"dashboard description\">\n                        A presentation view of the assessments recorded in this demo state. Live totals should come from the dashboard API.\n                    </p>\n                </div>\n          